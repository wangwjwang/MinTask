<!-- pages/task-create 新建任务 -->
<view class="page page--with-footer">

  <!-- ── 基本信息 ──────────────────────────────────────────────── -->
  <view class="form-head">基本信息</view>
  <view class="card">
    <view class="field">
      <view class="field__label field__label--required">{{isPlan ? '计划名称' : '任务名称'}}</view>
      <input
        class="field__input"
        placeholder="{{isPlan ? '例如：写报告 —— 系统会在名字前面加上期间' : '一句话说明要做什么'}}"
        placeholder-class="field__placeholder"
        value="{{form.task_name}}"
        data-field="task_name"
        maxlength="100"
        bindinput="onInput"
      />
    </view>

    <view class="field">
      <view class="field__label">{{isPlan ? '计划说明' : '任务详情 / 目标描述'}}</view>
      <textarea
        class="field__textarea"
        placeholder="最终要实现什么目的、验收标准是什么…"
        placeholder-class="field__placeholder"
        value="{{form.detail}}"
        data-field="detail"
        maxlength="2000"
        auto-height
        bindinput="onInput"
      />
    </view>

    <field-picker
      label="任务分类"
      field="category"
      value="{{form.category}}"
      options="{{categoryOptions}}"
      required
      bind:change="onEnumChange"
    />

    <!--
      从需求池点进来时来源锁死为「需求池」：这里干脆不渲染 picker，
      只显示一行 + 「已固定」—— 与上面「主办人 = 本人」同款处理。
      （灰掉一个 picker 只会做出"看着能点、点了也变"的假象。）
    -->
    <block wx:if="{{demandLocked}}">
      <view class="field--picker">
        <view class="field__label picker__label">任务来源</view>
        <view class="row">
          <text class="field__value">{{form.source}}</text>
          <text class="tag create__self-tag">已固定</text>
        </view>
      </view>
    </block>
    <field-picker
      wx:else
      label="任务来源"
      field="source"
      value="{{form.source}}"
      options="{{sourceOptions}}"
      required
      bind:change="onEnumChange"
    />

    <!--
      来源 = 需求池时才出现：必须指定关联哪一条待认领的需求。
      「领走」不是另一个按钮，而是"就这条需求建一个任务"这个动作本身 ——
      多一个"领走"按钮再接一层表单，等于同一个意图点两次。
      ★ !isPlan：计划不关联需求（计划是模板，没有"领走"这回事）
    -->
    <block wx:if="{{!isPlan && form.source === '需求池'}}">
      <block wx:if="{{demandLocked}}">
        <view class="field--picker">
          <view class="field__label field__label--required picker__label">关联需求</view>
          <view class="row">
            <text class="field__value ellipsis">{{demandTitle}}</text>
            <text class="tag create__self-tag">已选定</text>
          </view>
        </view>
      </block>
      <block wx:else>
        <picker mode="selector" range="{{demandOptions}}" range-key="title" bindchange="onDemandChange">
          <view class="field--picker">
            <view class="field__label field__label--required picker__label">关联需求</view>
            <view class="row">
              <text class="field__value {{demandId ? '' : 'field__value--empty'}}">
                {{demandTitle || '请选择要认领的需求'}}
              </text>
              <text class="field__arrow">›</text>
            </view>
          </view>
        </picker>
        <!--
          「池子空了」和「没拉到」必须分开说：前者让用户去建一条，
          后者是加载失败（重进本页就好），说成"没有需求"会把人支使去做无用功。
        -->
        <view wx:if="{{demandLoadFailed}}" class="t-muted create__tip">
          需求池没加载出来。可以把来源改成别的先建任务，或稍后重进本页。
        </view>
        <view wx:elif="{{!demandOptions.length}}" class="t-muted create__tip">
          需求池里暂时没有待认领的需求。可以先到「需求池」页提一条，或者把来源改成别的。
        </view>
      </block>
    </block>

    <field-picker
      label="任务性质"
      field="task_type"
      value="{{form.task_type}}"
      options="{{taskTypeOptions}}"
      bind:change="onEnumChange"
    />
  </view>

  <!-- ── 人员 ──────────────────────────────────────────────────── -->
  <view class="form-head">参与人员</view>
  <view class="card">
    <!-- 主办人：普通用户固定为自己，管理员可选他人 -->
    <block wx:if="{{canPickLeader}}">
      <picker mode="selector" range="{{leaderCandidates}}" range-key="name" bindchange="onLeaderChange">
        <view class="field--picker">
          <view class="field__label field__label--required picker__label">主办人</view>
          <view class="row">
            <text class="field__value">{{leaderName}}</text>
            <text class="field__arrow">›</text>
          </view>
        </view>
      </picker>
    </block>
    <view wx:else class="field--picker">
      <view class="field__label picker__label">主办人</view>
      <view class="row">
        <text class="field__value">{{leaderName}}</text>
        <text class="tag create__self-tag">本人</text>
      </view>
    </view>

    <!-- 协办人：多选 -->
    <view class="field--picker" bindtap="onToggleMemberPanel">
      <view class="field__label picker__label">协办人（可多选）</view>
      <view class="row">
        <text class="field__value {{collaboratorIds.length ? '' : 'field__value--empty'}}">
          {{collaboratorIds.length ? collaboratorIds.length + ' 人已选' : '未选择'}}
        </text>
        <text class="field__arrow">{{memberPanelOpen ? '⌄' : '›'}}</text>
      </view>
    </view>

    <!-- 协办人多选面板 -->
    <view wx:if="{{memberPanelOpen}}" class="create__members">
      <view wx:if="{{!allMembers.length}}" class="t-muted create__members-empty">
        暂无可选成员（其他成员需先认领身份）
      </view>
      <view
        wx:for="{{allMembers}}"
        wx:key="_id"
        class="pick-row hit {{collaboratorIds.indexOf(item.openid) !== -1 ? 'pick-row--on' : ''}}"
        data-openid="{{item.openid}}"
        bindtap="onToggleMember"
      >
        <view class="flex-1">
          <text class="pick-row__name">{{item.name}}</text>
          <text wx:if="{{item.dept}}" class="t-muted pick-row__dept">{{item.dept}}</text>
        </view>
        <view wx:if="{{collaboratorIds.indexOf(item.openid) !== -1}}" class="pick__check">✓</view>
      </view>
    </view>
  </view>

  <!-- ── 时间：一次性任务填具体日期 ─────────────────────────────── -->
  <view wx:if="{{!isPlan}}" class="form-head">时间</view>
  <view wx:if="{{!isPlan}}" class="card">
    <picker mode="date" value="{{form.start_date}}" start="{{minDate}}" end="{{maxDate}}" bindchange="onStartDateChange">
      <view class="field--picker">
        <view class="field__label picker__label">计划开始时间</view>
        <view class="row">
          <text class="field__value t-mono">{{form.start_date || '请选择'}}</text>
          <text class="field__arrow">›</text>
        </view>
      </view>
    </picker>

    <picker mode="date" value="{{form.due_date}}" start="{{minDate}}" end="{{maxDate}}" bindchange="onDueDateChange">
      <view class="field--picker">
        <view class="field__label field__label--required picker__label">计划截止时间</view>
        <view class="row">
          <text class="field__value t-mono {{form.due_date ? '' : 'field__value--empty'}}">
            {{form.due_date || '必填'}}
          </text>
          <text class="field__arrow">›</text>
        </view>
      </view>
    </picker>
  </view>

  <!-- ── 周期性：一次性任务的周期标注（选填）────────────────────── -->
  <block wx:if="{{!isPlan}}">
    <view class="form-head">周期（选填）</view>
    <view class="card">
      <field-picker
        label="周期频率"
        field="recur_freq"
        value="{{form.recur_freq}}"
        options="{{recurFreqOptions}}"
        bind:change="onEnumChange"
      />

      <view wx:if="{{form.recur_freq !== '不适用'}}" class="field">
        <view class="field__label">具体周期规则</view>
        <input
          class="field__input"
          placeholder="例如：每月第一个工作日 / 每季度末月 20 日"
          placeholder-class="field__placeholder"
          value="{{form.recur_rule}}"
          data-field="recur_rule"
          maxlength="200"
          bindinput="onInput"
        />
      </view>

      <view class="t-muted create__tip">
        想让系统定期自动生成任务（例如「每月写报告」）？把上面的「任务性质」
        改成「周期性」—— 本表单会切换成创建一份计划。当前建的是一次性任务，
        上面两项只是标注它的重复特点。
      </view>
    </view>
  </block>

  <!-- ── 计划排期：选「任务性质 = 周期性」时出现 ───────────────── -->
  <block wx:else>
    <view class="form-head">计划排期</view>
    <view class="card">
      <plan-schedule
        name="{{form.task_name}}"
        period-type-idx="{{periodTypeIdx}}"
        start-month-idx="{{startMonthIdx}}"
        start-day="{{startDay}}"
        end-month-idx="{{endMonthIdx}}"
        end-day="{{endDay}}"
        bind:change="onPlanScheduleChange"
      />

      <view class="t-muted create__tip">
        本表单建的是一份计划，不是任务。到了每期的开始日，系统自动生成当期任务
        （任务名 = 计划名称前面加上期间），主办人报进展、改状态都与普通任务一样。
        本期已过期就不再补生成。
      </view>
    </view>
  </block>
</view>

<view class="footer-bar">
  <button
    class="btn btn--primary"
    loading="{{submitting}}"
    disabled="{{submitting}}"
    bindtap="onSubmit"
  >{{isPlan ? '创建计划' : '创建任务'}}</button>
</view>
