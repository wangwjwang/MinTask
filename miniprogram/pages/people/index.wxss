/* pages/people 人员看板 */

/*
 * 未认领数用主色做轻量高亮，仅作强调，不可点击。
 * （原先"待认领"是可点的，点了会把未认领名单复制到剪贴板方便催认领；
 *   为通过微信隐私保护审核已移除剪贴板能力。）
 */
.people__unclaimed {
  color: var(--primary);
}

/* ── 管理员：重新关联历史数据 ── */

.people__admin {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx dashed var(--border);
  border-radius: var(--radius-sm);
  font-size: var(--fs-sub);
  color: var(--tone-active);
}

.people__admin-sub {
  font-size: var(--fs-micro);
  color: var(--muted);
}

/*
 * ★ 成员卡片（.member / .member__avatar / …）已上提到 app.wxss。
 *   认领页也要用同一张卡，而页面 WXSS 不跨页生效（样式隔离），
 *   所以共享定义只能放全局。与 .field--picker 是同一类处理。
 */
