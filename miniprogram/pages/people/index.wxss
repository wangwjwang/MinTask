/* pages/people 人员看板 */

/*
 * 未认领人数是可点的（点了复制名单发给同事催认领），
 * 所以在信息块里用主色 —— 主色在全站只表示"这个东西可以点"。
 * 原先用的 --tone-warn 是"有风险"的语义，认领还没完成不算是风险。
 */
.people__unclaimed {
  color: var(--primary);
}

/* ── 管理员：重新关联历史数据 ── */

.people__admin {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx dashed var(--border);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  color: var(--tone-active);
}

.people__admin-sub {
  font-size: 22rpx;
  color: var(--muted);
}

/* ── 成员卡片 ── */

.member {
  display: flex;
  align-items: center;
}

.member--me {
  border-left: 8rpx solid var(--primary);
}

.member--unclaimed {
  opacity: 0.6;
}

/*
 * 头像用姓名文字代替图片：团队 10 余人、名单固定，
 * 引入头像图片反而要多一套上传/存储流程，收益不值。
 */
.member__avatar {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: 1.2;
  overflow: hidden;
  padding: 0 6rpx;
  box-sizing: border-box;
}

.member__avatar--off {
  background: var(--divider);
  color: var(--muted);
}

.member__main {
  min-width: 0;
}

.member__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.member__tag {
  margin-left: 10rpx;
}

.member__dept {
  margin-top: 6rpx;
}

.member__stats {
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 12rpx;
}

.member__stat {
  font-size: 24rpx;
  color: var(--muted);
}

.member__num {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}

.member__stat--open .member__num {
  color: var(--primary);
}

.member__stat--done .member__num {
  color: var(--tone-ok);
}
