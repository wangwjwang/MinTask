/* pages/report */

/*
 * ── 吸顶的分组标题 ──────────────────────────────────────────────────
 * 「我主办 / 我协办 / 已完成」三个标题滚到顶部后留在那里，不再被推走。
 *
 * 四个点缺一个都会出问题：
 *   1. background 必须**不透明** —— 吸顶后卡片会从标题底下滚过；
 *   2. 负的左右外边距 + 等量左右内边距，用来抵消 .page 的 24rpx 内边距。
 *      不加的话吸顶条两侧各留一条 24rpx 的缝，滚动的内容会从缝里漏出来；
 *   3. 与下方卡片的间距靠 .section-title 自带的 padding-bottom(16rpx) 撑。
 *      如果改用 margin，那段不在背景覆盖范围内，吸顶时就会露出滚过的卡片；
 *   4. z-index 只给 2 —— 底部那条自定义 tabBar 是 100，必须压在吸顶条上面
 *      （滚到底时吸顶条正好紧贴 tabBar）。给大了它会盖住 tabBar。
 *
 * 吸附范围由父容器决定：每组都被 .report__group 包住，
 * 所以滚过本组后标题会被下一组的标题顶走，而不是一直跟到页面底部。
 */
.report__sticky {
  position: sticky;
  top: 0;
  z-index: 2;
  background: var(--bg);
  margin-left: calc(-1 * var(--gap));
  margin-right: calc(-1 * var(--gap));
  padding-left: var(--gap);
  padding-right: var(--gap);
}

/* 分组空了但另一组还有内容时的说明行（比 empty-state 轻，不喧宾夺主） */
.report__note {
  padding: 20rpx 4rpx;
  font-size: var(--fs-sub);
}

/* 「新加入协办」入口卡的样式已上提到 app.wxss 的 .entry-card
   （改任务页的「退出协办」入口是同一个视觉件，两页共用一份定义）。 */

/*
 * ── 久无进展提醒区 ──────────────────────────────────────────────────
 * 位置在信息块下面、第一个分组上面。条数为 0 时整块不渲染，不留空位。
 *
 * ★ 为什么是白卡 + 琥珀色天数，而不是红底/黄底：
 *   红＝受阻、黄＝有风险/逾期 这两个语义色在设计确定稿里已经被占满，
 *   这里是「该去报一下了」的提醒，不是告警。白卡浮在 --bg 上做区分，
 *   加一个 --tone-warn 的天数就够，不新增语义色。
 *   （--tone-warn 是既有的「注意」色，与逾期黄同源，但呈现位置不同 ——
 *     那边在卡片右下的日期上，不会混。）
 * ★ 标题左上的小圆点是唯一的装饰：一列白卡里给这块一个第一眼标记。
 */
/*
 * ── 自动生成待跟进 ──
 * 与下面的久无进展区同构（同一套行/分隔线），刻意不给它配彩色圆点：
 * 黄色圆点在那里表示"该管管了"，这一区是"系统替你排好的新任务"，
 * 不该借同一个告警信号。区分靠标题文案，不靠颜色。
 */
.report__fresh {
  padding-bottom: 8rpx;
}

.report__fresh-head {
  padding-bottom: 12rpx;
}

.report__fresh-title {
  font-size: var(--fs-sub);
  color: var(--text);
}

.report__fresh-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-top: 2rpx solid var(--divider);
}

.report__fresh-name {
  flex: 1;
  /* flex 子项默认 min-width:auto，不加这条 ellipsis 在长标题上不生效 */
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--text);
}

.report__fresh-due {
  margin-left: var(--gap-sm);
  font-size: var(--fs-caption);
  color: var(--muted);
}

.report__stale {
  /* .card 的 padding 是四边等值，行尾再多 8rpx 会显得下重上轻，收一点 */
  padding-bottom: 8rpx;
}

.report__stale-head {
  padding-bottom: 12rpx;
}

.report__stale-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--tone-warn);
  margin-right: 12rpx;
}

.report__stale-title {
  font-size: var(--fs-sub);
  color: var(--text);
}

.report__stale-count {
  font-size: var(--fs-caption);
  color: var(--muted);
}

/* 行间分隔线用 --divider，与 task-card / 表单页同款 */
.report__stale-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-top: 2rpx solid var(--divider);
}

.report__stale-name {
  flex: 1;
  /* flex 子项默认 min-width:auto，不加这条 ellipsis 在长标题上不生效 */
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--text);
}

.report__stale-days {
  margin-left: var(--gap-sm);
  font-size: var(--fs-caption);
  color: var(--tone-warn);
}

/* 折叠入口。★ 位置在标题下面、名单上面（理由见 wxml 里的注释：放下方会
   随展开往下挪，连点两次会误点到任务行）。
   靠右，与分组标题上「收起 ▲ / 展开 ▼」的位置习惯一致；整行可点
   （比文字本身大得多），所以不用给文字加 padding 撑点击区。 */
.report__stale-more {
  padding: 16rpx 0 12rpx;
  border-top: 2rpx solid var(--divider);
  text-align: right;
  font-size: var(--fs-caption);
  color: var(--muted);
}
