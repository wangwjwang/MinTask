<!-- pages/people Tab4 人员看板 -->
<view class="page">

  <view wx:if="{{loading}}" class="loading-block">正在加载人员…</view>

  <block wx:else>
    <!--
      ── 信息块 ───────────────────────────────────────────────────
      导航栏已写「人员看板」，页内不再重复标题，放信息：总人数 + 认领情况。
      认领进度是这一页唯一需要"管理"的事（未认领的人点不进任务），
      所以它占信息块的位置，而不是缩在角落一行小字。
    -->
    <view class="summary">
      <view class="summary__value">
        <text>共 {{members.length}}</text>
        <text class="summary__unit">人</text>
      </view>
      <view class="summary__stats">
        <text wx:if="{{unclaimedCount}}">已认领 {{claimedCount}}</text>
        <text
          wx:if="{{unclaimedCount}}"
          class="people__unclaimed hit"
          bindtap="onCopyUnclaimed"
        >待认领 {{unclaimedCount}} · 点击复制名单</text>
        <text wx:else>全部已认领</text>
      </view>
    </view>

    <!-- 导入历史任务表后，把只有姓名、还没挂 openid 的任务/进展补上归属。
         幂等，可反复点。仅在有人认领之后才有意义。 -->
    <view
      wx:if="{{isAdmin && claimedCount}}"
      class="people__admin hit"
      bindtap="onRelink"
    >
      <text>把历史任务关联到已认领的同事</text>
      <text class="people__admin-sub">已认领 {{claimedCount}} 人 · 点此补齐主办/协办归属</text>
    </view>

    <empty-state
      wx:if="{{!members.length}}"
      title="还没有成员"
      hint="请管理员在云数据库 members 集合导入全员名单"
    />

    <!-- ── 成员卡片 ─────────────────────────────────────────────── -->
    <view
      wx:for="{{members}}"
      wx:key="_id"
      class="card member hit {{item._isMe ? 'member--me' : ''}} {{item.claimed ? '' : 'member--unclaimed'}}"
      data-openid="{{item.openid}}"
      data-name="{{item.name}}"
      bindtap="onMemberTap"
    >
      <!-- 头像占位：直接渲染整个姓名（两三个字），避免引入图片资源 -->
      <view class="member__avatar {{item.claimed ? '' : 'member__avatar--off'}}">
        {{item.name}}
      </view>

      <view class="flex-1 member__main">
        <view class="row">
          <text class="member__name">{{item.name}}</text>
          <text wx:if="{{item._isMe}}" class="tag member__tag">我</text>
          <text wx:if="{{item.role === '管理员'}}" class="badge badge--active member__tag">管理员</text>
          <text wx:if="{{!item.claimed}}" class="badge badge--idle member__tag">未认领</text>
        </view>

        <view class="row member__dept" wx:if="{{item.dept}}">
          <text class="t-muted">{{item.dept}}</text>
        </view>

        <!-- 负载数字 -->
        <view class="row member__stats">
          <text class="member__stat">
            <text class="member__num">{{item.led}}</text> 主办
          </text>
          <text class="member__stat">
            <text class="member__num">{{item.joined}}</text> 协办
          </text>
          <text class="member__stat member__stat--open" wx:if="{{item.open}}">
            在办 <text class="member__num">{{item.open}}</text>
          </text>
          <text class="member__stat member__stat--done" wx:if="{{item.done}}">
            已完成 {{item.done}}
          </text>
        </view>

        <!--
          近两周动静。单独一行、口径与上面的负载数字不同（那几个是历史累计，
          这个是近期活跃度），混进同一行会被当成同一维度的数字。
        -->
        <view class="row member__recent {{item.recent ? '' : 'member__recent--none'}}">
          <text>{{item._recentText}}</text>
        </view>
      </view>

      <text class="field__arrow">›</text>
    </view>
  </block>
</view>
