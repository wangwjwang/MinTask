<!--
  components/task-card
  任务卡片。所有展示用的派生字段（_dueText / _statusTone / _catColor 等）
  都由 utils/format.js 的 decorateTask 预先算好，这里只负责渲染。

  ★ _catColor 必须是 decorateTask 产出的十六进制字面量 —— WXML 不能调 JS 函数，
    所以分类色只能这样内联给出，不能在模板里现算。
-->
<view
  wx:if="{{task}}"
  class="task-card hit {{task._hasBlocker ? 'card--blocked' : ''}}"
  bindtap="onTap"
>
  <!--
    第一行：分类色方块 + 任务名 + 右上角标签
    ★ 右上角放什么由 recurMode 定：周期语境放周期频率（「每月」），否则放任务来源。
      两条分支必须紧挨着，中间不能插注释 —— 会断开 wx:if / wx:elif 链。
    ★ 周期性任务若没填周期频率（recur_freq = 不适用），右上角就显示「不适用」：
      与看板把这类任务排在最后的做法一致，比留空或退回显示来源更诚实。
  -->
  <view class="row row--between row--top task-card__head">
    <view class="row row--top flex-1 task-card__title">
      <view class="chip__dot chip__dot--lead" style="background: {{task._catColor}}"></view>
      <view class="t-title ellipsis-2 task-card__name">{{task.task_name}}</view>
    </view>
    <view wx:if="{{recurMode && task.recur_freq}}" class="tag task-card__source">{{task.recur_freq}}</view>
    <view wx:elif="{{!recurMode && task.source}}" class="tag task-card__source">{{task.source}}</view>
  </view>

  <!-- 第二行：状态 / 阶段 / 卡壳标记 -->
  <view class="row row--wrap task-card__tags">
    <view class="badge badge--{{task._statusTone}}">{{task.status}}</view>
    <view class="badge badge--{{task._stageTone}}">{{task.stage}}</view>
    <view wx:if="{{task._hasBlocker}}" class="blocker-flag">
      <text>卡壳</text>
    </view>
    <!-- 周期语境下右上角已经写着周期了，这里再挂一个「周期」就是重复 -->
    <view wx:if="{{task.origin === 'periodic' && !recurMode}}" class="tag">周期</view>
  </view>

  <!-- 进度条 -->
  <view wx:if="{{showProgress}}" class="task-card__progress">
    <view class="row row--between task-card__progress-head">
      <text class="t-muted">进度</text>
      <text class="t-mono t-sub">{{task._progressWidth}}%</text>
    </view>
    <view class="progress">
      <view
        class="progress__bar {{task.stage === '已完成' ? 'progress__bar--done' : ''}} {{task._overdue ? 'progress__bar--danger' : ''}}"
        style="width: {{task._progressWidth}}%;"
      ></view>
    </view>
  </view>

  <!--
    底部一行：分类 · 主办 · 协办                      截止日
    v1 这里是最多三行（分类 / 主办 / 协办 各占一行），压成一行后
    卡片变矮、列表更清爽。三个片段按 props 条件拼接。
  -->
  <view class="task-card__meta">
    <text class="t-muted ellipsis task-card__meta-text">{{task.category}}{{showLeader && task.leader ? ' · 主办 ' + task.leader : ''}}{{showCollaborators ? ' · 协办 ' + task._collaboratorText : ''}}</text>
    <text class="t-muted t-mono task-card__due task-card__due--{{task._dueTone}}">{{task._dueText}}</text>
  </view>
</view>
