<!-- pages/task-edit 修改任务（编辑：仅主办人；删除：主办人或管理员）-->
<view class="page page--with-footer">

  <view wx:if="{{loading}}" class="loading-block">正在加载…</view>

  <!--
    ── 编辑表单：仅主办人 ──────────────────────────────────────────
    ★ 用独立的 wx:if 而不是接在 loading 后面的 wx:else —— 本页还接待
      "只满足删除的管理员"，他们要看到下面的危险区，但看不到这屏表单。
      也刻意不写成 wx:if/wx:elif 链：链中间不能插注释（见 update 页的告示）。
  -->
  <block wx:if="{{!loading && canEdit}}">
    <!-- ── 名称与详情 ────────────────────────────────────────────── -->
    <view class="card">
      <view class="field">
        <view class="field__label field__label--required">任务名称</view>
        <input
          class="field__input"
          value="{{form.task_name}}"
          data-field="task_name"
          maxlength="100"
          bindinput="onInput"
        />
      </view>

      <view class="field">
        <view class="field__label">任务详情 / 目标描述</view>
        <textarea
          class="field__textarea"
          placeholder="最终要实现什么目的…"
          placeholder-class="field__placeholder"
          value="{{form.detail}}"
          data-field="detail"
          maxlength="2000"
          auto-height
          bindinput="onInput"
        />
      </view>
    </view>

    <!-- ── 推进状态（主办人最常改的一组）─────────────────────────── -->
    <view class="card">
      <view class="section-title">
        <text>推进状态</text>
      </view>

      <view class="field">
        <view class="row row--between">
          <text class="field__label">整体进度</text>
          <text class="t-mono t-sub">{{form.progress}}%</text>
        </view>
        <slider
          min="0"
          max="100"
          step="5"
          value="{{form.progress}}"
          activeColor="{{primaryColor}}"
          block-size="24"
          bindchanging="onProgressChange"
          bindchange="onProgressChange"
        />
      </view>

      <field-picker
        label="任务状态（健康度）"
        field="status"
        value="{{form.status}}"
        options="{{statusOptions}}"
        bind:change="onEnumChange"
      />

      <field-picker
        label="任务阶段"
        field="stage"
        value="{{form.stage}}"
        options="{{stageOptions}}"
        bind:change="onEnumChange"
      />

      <view class="t-muted edit__tip">
        「状态」表示任务健不健康（正常/有风险/受阻/已完成），
        「阶段」表示做到哪一步了（未开始/进行中/已完成）。
        阶段改为「已完成」时，系统会自动填写实际完成时间。
      </view>
    </view>

    <!-- ── 分类与优先级 ──────────────────────────────────────────── -->
    <view class="card">
      <field-picker
        label="任务分类"
        field="category"
        value="{{form.category}}"
        options="{{categoryOptions}}"
        bind:change="onEnumChange"
      />
      <field-picker
        label="任务来源"
        field="source"
        value="{{form.source}}"
        options="{{sourceOptions}}"
        bind:change="onEnumChange"
      />
      <field-picker
        label="任务性质"
        field="task_type"
        value="{{form.task_type}}"
        options="{{taskTypeOptions}}"
        bind:change="onEnumChange"
      />
    </view>

    <!-- ── 时间 ──────────────────────────────────────────────────── -->
    <view class="card">
      <picker mode="date" value="{{form.start_date}}" start="{{minDate}}" end="{{maxDate}}" data-field="start_date" bindchange="onDateChange">
        <view class="field--picker">
          <view class="field__label picker__label">计划开始时间</view>
          <view class="row">
            <text class="field__value t-mono {{form.start_date ? '' : 'field__value--empty'}}">
              {{form.start_date || '未设置'}}
            </text>
            <text class="field__arrow">›</text>
          </view>
        </view>
      </picker>

      <picker mode="date" value="{{form.due_date}}" start="{{minDate}}" end="{{maxDate}}" data-field="due_date" bindchange="onDateChange">
        <view class="field--picker">
          <view class="field__label picker__label">计划截止时间</view>
          <view class="row">
            <text class="field__value t-mono {{form.due_date ? '' : 'field__value--empty'}}">
              {{form.due_date || '未设置'}}
            </text>
            <text class="field__arrow">›</text>
          </view>
        </view>
      </picker>

      <picker mode="date" value="{{form.actualCompleteTime}}" start="{{minDate}}" end="{{maxDate}}" data-field="actualCompleteTime" bindchange="onDateChange">
        <view class="field--picker">
          <view class="field__label picker__label">实际完成时间</view>
          <view class="row">
            <text class="field__value t-mono {{form.actualCompleteTime ? '' : 'field__value--empty'}}">
              {{form.actualCompleteTime || '未完成'}}
            </text>
            <text class="field__arrow">›</text>
          </view>
        </view>
      </picker>
    </view>

    <!-- ── 协办人 ────────────────────────────────────────────────── -->
    <view class="card">
      <view class="field--picker" bindtap="onToggleMemberPanel">
        <view class="field__label picker__label">协办人（{{collaboratorIds.length}} 人）</view>
        <view class="row">
          <text class="field__value">{{memberPanelOpen ? '收起' : '管理'}}</text>
          <text class="field__arrow">{{memberPanelOpen ? '⌄' : '›'}}</text>
        </view>
      </view>

      <view wx:if="{{memberPanelOpen}}" class="edit__members">
        <view
          wx:for="{{allMembers}}"
          wx:key="_id"
          class="pick-row hit {{collaboratorIds.indexOf(item.openid) !== -1 ? 'pick-row--on' : ''}}"
          data-openid="{{item.openid}}"
          bindtap="onToggleMember"
        >
          <view class="flex-1">
            <text class="pick-row__name">{{item.name}}</text>
            <text wx:if="{{item.dept}}" class="t-muted pick-row__dept">{{item.dept}}</text>
          </view>
          <view wx:if="{{collaboratorIds.indexOf(item.openid) !== -1}}" class="pick__check">✓</view>
        </view>
      </view>
    </view>

    <!--
      主办人不可改：leaderId 是权限判定的根基，换主办人等于转移任务所有权，
      不在本期需求范围内。需要换人时由管理员重建任务。
    -->
    <view class="card card--flat">
      <view class="row row--between">
        <text class="t-muted">主办人</text>
        <text class="t-sub">{{task.leader}}</text>
      </view>
    </view>
  </block>

  <!--
    ── 危险区：删除任务 ─────────────────────────────────────────────
    ★ 放在滚动内容的最底部，**不放固定底栏**。底栏是「保存」的地盘，
      删除混进去迟早有人手滑点到。
    ★ 红描边不填充，与 .btn--danger 的实心红刻意区分开。
    ★ 显隐走 perm.canDeleteTask（与云函数同源）：主办人恒真；
      管理员即使不是主办人也为真。
    ★ 这一块**在编辑表单之外**，所以非主办人的管理员也看得到。
      上面的分隔线只在有表单时才画，免得管理员那屏顶着一根孤线。
    ⚠️ 但非主办人的管理员目前没有入口能走到本页（入口只列我主办的任务、
      详情页也只对主办人露出编辑入口）。这一屏和 index.js 里的 canDelete
      判据是先备好的，等有入口才真正生效 —— 别以为缺口已经补上，
      详见 index.js load() 里的长注释。
  -->
  <block wx:if="{{!loading && canDelete}}">
    <view wx:if="{{canEdit}}" class="divider"></view>

    <view class="card card--flat edit__danger-zone">
      <view class="t-muted edit__danger-tip">
        删除后，这个任务及其全部进展记录都会消失，无法恢复。
      </view>
      <button class="btn edit__danger" bindtap="onDelete">删除该任务</button>
    </view>
  </block>
</view>

<!-- ★ 底栏跟着编辑表单走（canEdit），不是跟着"加载完了"走：
     非主办人的管理员进得来（为了删任务），但他没有可保存的东西。 -->
<view wx:if="{{!loading && canEdit}}" class="footer-bar">
  <view class="row edit__footer">
    <button class="btn btn--plain edit__reset" bindtap="onReset" disabled="{{!dirtyCount}}">
      还原
    </button>
    <button
      class="btn btn--primary flex-1"
      loading="{{saving}}"
      disabled="{{saving || !dirtyCount}}"
      bindtap="onSubmit"
    >{{dirtyCount ? '保存（' + dirtyCount + ' 项修改）' : '保存'}}</button>
  </view>
</view>
