<!-- pages/report Tab1 报任务 -->
<view class="page page--with-footer">

  <view wx:if="{{loading}}" class="loading-block">正在加载任务…</view>

  <block wx:else>
    <!--
      ── 信息块 ───────────────────────────────────────────────────
      页内不放「报任务」大标题 —— 导航栏已经写了，重复。
      这里放**信息**：姓名 + 三个分组的条数。
      姓名不是装饰：本页与 person-detail 用的是同一套任务卡片，
      顶上写清楚是谁的列表，才能一眼分清"我的"和"别人的"。
      三个数字与下方三个分组标题上的计数完全同源，可当场核对。
    -->
    <view class="summary">
      <view class="summary__value">{{myName}}</view>
      <view class="summary__stats">
        <text>主办 {{stats.led}}</text>
        <text>协办 {{stats.joined}}</text>
        <text>已完成 {{stats.done}}</text>
      </view>
    </view>

    <!--
      ── 久无进展提醒 ─────────────────────────────────────────────
      有的任务十天半月没人碰，混在几十条里就沉底了。这里把跨主办/协办
      汇总去重后最久没动的几条拎到最上面 —— 位置本身就是这个功能的价值，
      沉到列表里等于没做。
      ★ 一条都没有时整块不渲染（wx:if），不留空位、不占一屏。
      ★ 它不是第四个分组，是**跨前两组的子集**：条数不进 stats，
        那三个数字与下方三个分组标题同源，塞进来就破坏了不变式。
      ★ 任务名不换行（要全名点进详情），天数靠右对齐 —— 一列数字比一列
        长短不一的标题更好扫。
      ★ 名单超过阈值（page.js 的 STALE_COLLAPSE_AT）就只铺阈值那么多条，
        最久没动的在前，其余折起来点开看 —— 有二十条就铺二十行的话，
        它自己会把下面真正要看的分组挤下去。
      ★ 展开状态不跨页面保留：切走再回来一律是折起的（onShow 里重置）。
    -->
    <view wx:if="{{stale.length}}" class="card report__stale">
      <view class="row row--between report__stale-head">
        <view class="row">
          <view class="report__stale-dot"></view>
          <text class="report__stale-title">{{staleDays}} 天以上没有新进展</text>
        </view>
        <text class="report__stale-count">{{stale.length}} 项</text>
      </view>

      <!--
        折叠入口。★ 必须在名单**上方**，不能放下面：
        它一旦放在末尾，展开时头顶多出一行，按钮就往下挪一行的高度 ——
        用户按原位再点一下，点中的是新冒出来的那条**任务行**（任务行自己
        也可点，会跳上报页），于是「展开完收不回去」，而且每次复现都一样。
        放在上面，展开/收起它自己一动不动，连点两次必定是同一个按钮。
        隐藏判据是条数（见 page.js 的 STALE_COLLAPSE_AT），不是"有没有折起来"。
      -->
      <view
        wx:if="{{staleFoldable}}"
        class="report__stale-more hit"
        bindtap="onToggleStale"
      >
        <text>{{staleExpanded ? '收起 ▲' : '展开其余 ' + staleMore + ' 项 ▼'}}</text>
      </view>

      <view
        wx:for="{{staleShown}}"
        wx:key="_id"
        class="report__stale-row hit"
        data-task="{{item}}"
        bindtap="onStaleTap"
      >
        <text class="report__stale-name ellipsis">{{item.task_name}}</text>
        <text class="report__stale-days t-mono">{{item._idleDays}} 天</text>
      </view>
    </view>

    <!--
      ── 区块 1：我主办的任务（在办）──────────────────────────────
      ★ 每组包一层 report__group：吸顶标题的吸附范围被限制在自己这一组内，
        滚过本组后会被下一组的标题顶走。不包的话标题的父容器就是 .page，
        三个标题会一直叠在最上面互相盖住。
    -->
    <view class="report__group">
      <view class="section-title hit report__sticky" bindtap="onToggleLed">
        <text>我主办的任务</text>
        <text class="section-title__count">{{led.length}} 项 {{showLed ? '收起 ▲' : '展开 ▼'}}</text>
      </view>

      <!-- 三个分支：有在办 / 全做完了（指路到下方已完成）/ 一条都没有 -->
      <block wx:if="{{showLed}}">
        <block wx:if="{{led.length}}">
          <task-card
            wx:for="{{led}}"
            wx:key="_id"
            task="{{item}}"
            bind:tap="onTaskTap"
          />
        </block>
        <view wx:elif="{{ledDone.length}}" class="t-muted report__note">
          主办的任务都已完成，见下方「已完成」
        </view>
        <empty-state
          wx:else
          title="还没有你主办的任务"
          hint="点击下方「新建任务」创建第一项"
        />
      </block>
    </view>

    <view class="divider"></view>

    <!-- ── 区块 2：我参与的协办任务（在办）──────────────────────── -->
    <view class="report__group">
      <view class="section-title hit report__sticky" bindtap="onToggleJoined">
        <text>我参与的协办任务</text>
        <text class="section-title__count">{{joined.length}} 项 {{showJoined ? '收起 ▲' : '展开 ▼'}}</text>
      </view>

      <block wx:if="{{showJoined}}">
        <block wx:if="{{joined.length}}">
          <task-card
            wx:for="{{joined}}"
            wx:key="_id"
            task="{{item}}"
            show-collaborators="{{false}}"
            show-leader="{{true}}"
            bind:tap="onTaskTap"
          />
        </block>
        <view wx:elif="{{joinedDone.length}}" class="t-muted report__note">
          协办的任务都已完成，见下方「已完成」
        </view>
        <empty-state
          wx:else
          title="还没有你协办的任务"
          hint="点击下方「新加入协办」认领他人任务"
        />
      </block>
    </view>

    <view class="divider"></view>

    <!-- ── 区块 3：已完成（默认收起，放最下）─────────────────────── -->
    <view wx:if="{{doneAll.length}}" class="report__group">
      <view class="section-title hit report__sticky" bindtap="onToggleDone">
        <text>已完成</text>
        <text class="section-title__count">{{doneAll.length}} 项 {{showDone ? '收起 ▲' : '展开 ▼'}}</text>
      </view>

      <block wx:if="{{showDone}}">
        <task-card
          wx:for="{{doneAll}}"
          wx:key="_id"
          task="{{item}}"
          show-progress="{{false}}"
          bind:tap="onTaskTap"
        />
      </block>
    </view>

    <!-- ── 区块 4：新加入协办入口 ─────────────────────────────────── -->
    <view class="card card--flat entry-card hit" bindtap="onJoinTap">
      <view class="row row--between">
        <view class="flex-1">
          <view class="t-title">新加入协办</view>
          <view class="t-muted">浏览他人主办的任务，无需审批即可加入</view>
        </view>
        <text class="field__arrow">›</text>
      </view>
    </view>
  </block>
</view>

<!-- ── 区块 5：新建任务（页面最底部固定按钮）────────────────────── -->
<view class="footer-bar">
  <button class="btn btn--primary" bindtap="onCreateTap">＋ 新建任务</button>
</view>
