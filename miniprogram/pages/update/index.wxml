<!-- pages/update Tab2 改任务 -->
<view class="page page--tabbar">

  <!--
    ── 信息块 ─────────────────────────────────────────────────────
    导航栏已写「改任务」，页内不再重复标题，放信息：姓名 + 在办/逾期。
    ★ 逾期为 0 时不标红 —— 天天报警的数字很快就没人看了。
      标红只在真的有事要处理时出现。
  -->
  <view class="summary">
    <view class="summary__value">{{myName}}</view>
    <view class="summary__stats">
      <text>在办 {{stats.open}}</text>
      <text class="{{stats.overdue ? 'update__overdue' : ''}}">逾期 {{stats.overdue}}</text>
    </view>
  </view>

  <view wx:if="{{loading && !tasks.length}}" class="loading-block">正在加载…</view>

  <block wx:else>
    <!--
      ── 在办任务 ──────────────────────────────────────────────────
      ★ 下面两条是一个 wx:if / wx:elif 链，中间**不能插注释**。

      ★ 空态只在"一条任务都没有"时出场。别改成 openTasks.length === 0：
        任务全做完时上方列表是空的、但下方还有已完成组可看，
        那时弹"还没有你主办的任务"是误导。
      ★ 这里原来还有一层阶段筛选（2026-10-03 用户拍板删除），
        连同"该阶段下没有任务"那条空态一起没了。
    -->
    <block wx:if="{{openTasks.length}}">
      <task-card
        wx:for="{{openTasks}}"
        wx:key="_id"
        task="{{item}}"
        bind:tap="onTaskTap"
      />
    </block>
    <empty-state
      wx:elif="{{!tasks.length}}"
      title="还没有你主办的任务"
      hint="请到「报任务」页新建任务"
    />

    <!-- ── 已完成（默认收起，放最下）─────────────────────────────── -->
    <block wx:if="{{doneTasks.length}}">
      <view class="divider"></view>

      <view class="section-title hit" bindtap="onToggleDone">
        <text>已完成</text>
        <text class="section-title__count">{{doneTasks.length}} 项 {{showDone ? '收起 ▲' : '展开 ▼'}}</text>
      </view>

      <block wx:if="{{showDone}}">
        <task-card
          wx:for="{{doneTasks}}"
          wx:key="_id"
          task="{{item}}"
          show-progress="{{false}}"
          bind:tap="onTaskTap"
        />
      </block>
    </block>

    <!-- ── 管理我的计划入口 ───────────────────────────────────────── -->
    <view class="card card--flat entry-card hit" bindtap="onPlansTap">
      <view class="row row--between">
        <view class="flex-1">
          <view class="t-title">管理我的计划</view>
          <view class="t-muted">周期性计划：看排期、改设置或删除</view>
        </view>
        <text class="field__arrow">›</text>
      </view>
    </view>

    <!-- ── 退出协办入口 ───────────────────────────────────────────── -->
    <view class="card card--flat entry-card hit" bindtap="onLeaveTap">
      <view class="row row--between">
        <view class="flex-1">
          <view class="t-title">退出协办</view>
          <view class="t-muted">浏览你参与协办的任务，可自行退出</view>
        </view>
        <text class="field__arrow">›</text>
      </view>
    </view>
  </block>
</view>
