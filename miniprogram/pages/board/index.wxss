/* pages/board 任务看板 */

.board__summary {
  padding: 4rpx 0 var(--gap);
}

/* 分类筛选胶囊的外观定义在 app.wxss 的 .filter-pill（与改任务页共用），
   这里只补本页需要的外边距 */
.board__filter {
  margin-bottom: var(--gap-sm);
}

.board__seg {
  margin-bottom: var(--gap-sm);
}

/* ── 列内的分类分组 ────────────────────────────────────────────── */

.board__group {
  margin-bottom: var(--gap-sm);
}

/*
 * 分类标题吸顶。
 *
 * 这一层专门用来吸顶，而不是把 position:sticky 直接挂在 .board__group-head 上，
 * 是为了让背景能盖住标题与卡片之间的缝：
 * 吸附范围由父容器 .board__group 决定，所以滚过本组后标题会被下一组顶走。
 *
 * 三个点：
 *   1. background 必须**不透明**（用页面底色），否则吸顶后卡片会从标题底下透出来；
 *   2. 与卡片的间距做成这一层的 padding-bottom，而不是 head 的 margin ——
 *      margin 不在背景覆盖范围内，吸顶时那段缝会露出滚过的卡片；
 *   3. 负的左右外边距 + 等量左右内边距，抵消 .page 的 28rpx 内边距，
 *      让吸顶条横贯整屏。与 report 的 .report__sticky 是同一套做法。
 */
.board__group-sticky {
  position: sticky;
  top: 0;
  z-index: 2;
  background: var(--bg);
  margin-left: calc(-1 * var(--gap));
  margin-right: calc(-1 * var(--gap));
  padding-left: var(--gap);
  padding-right: var(--gap);
  padding-bottom: 12rpx;
}

/*
 * 分类标题行。分类色方块在最左，竖列扫读时形成一条颜色带。
 * 不做边框不做底 —— 分组之间的层级靠留白和方块的颜色区分，
 * 少一层描边观感更干净。
 */
.board__group-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
}

.board__group-title {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-sub);
}

.board__group-count {
  flex-shrink: 0;
  font-size: var(--fs-caption);
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}

.board__group-arrow {
  flex-shrink: 0;
  width: 24rpx;
  font-size: var(--fs-micro);
  color: var(--muted);
}
