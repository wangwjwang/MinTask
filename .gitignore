# ── 依赖 ──────────────────────────────────────────────────────────────
node_modules/
cloudfunctions/*/node_modules/

# 注意：miniprogram/shared/ 与 cloudfunctions/*/lib/shared/ 是
# scripts/sync-shared.js 生成的副本，但**必须提交进仓库** ——
# 否则别人 clone 下来无法直接编译（会缺模块）。
# 这是「零构建步骤」约束的代价，不要把它们加进 .gitignore。
#
# ★ 唯一的例外是 dashboardService（电脑端看板的只读云函数）：
#   它的 index.js 只 require('wx-server-sdk')，**完全不用 shared/** ——
#   有意做成自包含的，好让电脑端与小程序端互不牵连。
#   但 sync-shared.js 是按目录扫的，会照灌一份进去。那份副本：
#     1. 没有任何 require 指向它，是纯粹的死代码；
#     2. 会随 shared/ 变化而无意义地产生 diff 噪音；
#     3. 最要命的是会让人以为"dashboardService 依赖 shared，
#        所以 shared 一改它也得重新部署"—— 它不用。
#   所以单独忽略掉。它在磁盘上会被 sync 重新生成，这是正常的。
cloudfunctions/dashboardService/lib/

# ── 密钥与本地配置（★ 绝对不要提交）────────────────────────────────────
*.env
.env*
# 云函数的本地环境变量文件
cloudfunctions/*/env.json
cloudfunctions/*/.env
# 本地调试用的私有配置
miniprogram/config.local.js
private.config.json
project.private.config.json

# ── 微信开发者工具 ────────────────────────────────────────────────────
.DS_Store
*.log
# 工具生成的临时目录
miniprogram_npm/
cloudfunctions/*/node_modules/.cache/

# ── 编辑器 ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ── 构建产物 ──────────────────────────────────────────────────────────
dist/
build/

# ── 成员名单转换产物 ──────────────────────────────────────────────────
# scripts/make-member-import.js 由 members.json 生成，用于导入云数据库。
# 它是派生物，提交进来反而危险：改了 members.json 却忘了重新生成时，
# 仓库里会躺着一份过期名单，被误导入线上集合。
# ★ members.json（源文件）要提交，这个不要。
scripts/members.import.json

# ── 云开发控制台导出的数据库快照 ──────────────────────────────────────
# 从云开发控制台「导出」下载的 JSON Lines 文件，用来在本地核对数据、
# 或改库前留个底。**绝对不要提交**：
#   1. 它们含真实 openid（微信身份标识，比姓名更敏感），
#      而 git 历史是永久的，进去就不好彻底清除；
#   2. 它们是某一时刻的快照，提交进来必然很快过期，
#      下次看到会误以为是最新数据。
# 需要备份就复制到仓库外的目录，或者用控制台的备份功能。
scripts/database_export-*

# ── 历史任务表转换产物 ────────────────────────────────────────────────
# 同理：tasks.source.csv 是源，这两份是派生物。
# 它们动辄上百条、几十 KB，提交进来只会让 diff 噪音变大，
# 而且它们**必须**与源表同时更新，一旦不同步就是"看到的数据和库里不一样"。
scripts/tasks.import.json
scripts/progress_records.import.json

# ── 协办名单修复产物 ──────────────────────────────────────────────────
# make-collab-fix-import.js 生成，整份文档覆盖导入用。
# 里面是真实姓名 + openid 的某一时刻快照，同样是派生物，不进仓库。
scripts/tasks.collabfix.import.json
# make-collab-each-fix-import.js 生成，同理（还原被写坏的 collaboratorIds）。
scripts/tasks.colleachfix.import.json

# ── 电脑端看板（dashboard/）：凭据与临时脚本 ──────────────────────────
# cloudbaserc.json 的 functions.envVariables 里带着 DASHBOARD_PASSCODE
# 明文 —— 它既是部署配置也是看板访问口令，和上面「密钥与本地配置」同一性质。
# 要保留一份可提交的模板，就另存 cloudbaserc.example.json 并把口令留空。
cloudbaserc.json
# 下面三个是 2026-10-07 联调时的一次性脚本，每个都硬编码了腾讯云
# SecretId / SecretKey（能操作整个 CloudBase 环境的凭据）。
# ★ 千万不要 `git add -f`。密钥已经落在文件里了，建议尽早去控制台吊销重建。
_verify_keys.mjs
_verify_tcb.mjs
tp_api.js
_verify_*.mjs
# 看板联调脚本（硬编码环境 ID 与访问口令）
dashboard/tp_test.mjs
# tcb CLI 的输出转储
_hosting_list.txt

# ── 云函数依赖锁文件 ──────────────────────────────────────────────────
# 其余 7 个云函数仓库里都没有锁文件，这里保持一致；
# 依赖由云端 installDependency 按 package.json 安装。
cloudfunctions/*/package-lock.json

