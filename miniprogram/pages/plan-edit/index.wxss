/* pages/plan-edit */

/*
 * .field--picker / .picker__label 在 app.wxss；
 * 成员行（.pick-row 系列）与勾选标记（.pick__check）也在 app.wxss；
 * 只读摘要（.edit__ro-*）与危险区（.edit__danger-* / .edit__state / .edit__tip）
 * 已因需求编辑页共用而上提到 app.wxss。
 * 本页不重复定义。
 */

.edit__members {
  margin-top: 8rpx;
  border-top: 2rpx solid var(--divider);
  padding-top: 8rpx;
  max-height: 640rpx;
  overflow-y: auto;
}

.edit__members-empty {
  padding: 24rpx 0;
}
