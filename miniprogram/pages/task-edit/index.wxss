/* pages/task-edit */

/*
 * .field--picker / .picker__label 已上提到 app.wxss ——
 * 本页原先抄了一份和 field-picker 组件完全相同的定义，现已删除。
 */

.edit__tip {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-sm);
  background: var(--bg);
  line-height: 1.6;
}

/* ── 协办人管理面板 ── */

.edit__members {
  margin-top: 8rpx;
  border-top: 2rpx solid var(--divider);
  padding-top: 8rpx;
  max-height: 640rpx;
  overflow-y: auto;
}

.edit__member {
  display: flex;
  align-items: center;
  padding: 22rpx 4rpx;
  border-bottom: 2rpx solid var(--divider);
}

.edit__member:last-child {
  border-bottom: none;
}

.edit__member--on {
  color: var(--primary);
}

.edit__member-name {
  font-size: 28rpx;
}

.edit__member-dept {
  margin-left: 12rpx;
}

.edit__member-check {
  color: var(--primary);
  font-size: 32rpx;
  font-weight: 600;
}

/* ── 底部按钮组 ── */

.edit__footer {
  gap: 16rpx;
}

.edit__reset {
  width: 180rpx;
  flex-shrink: 0;
}
