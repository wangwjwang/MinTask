/* pages/board 任务看板 */

.board__summary {
  padding: 4rpx 0 var(--gap);
}

.board__seg {
  margin-bottom: var(--gap-sm);
}

/* ── 列内的分类分组 ────────────────────────────────────────────── */

.board__group {
  margin-bottom: var(--gap-sm);
}

/*
 * 分类标题吸顶。
 *
 * 这一层专门用来吸顶，而不是把 position:sticky 直接挂在 .board__group-head 上，
 * 是为了让背景能盖住标题与卡片之间的缝：
 * 吸附范围由父容器 .board__group 决定，所以滚过本组后标题会被下一组顶走。
 *
 * 三个点：
 *   1. background 必须**不透明**（用页面底色），否则吸顶后卡片会从标题底下透出来；
 *   2. 与卡片的间距做成这一层的 padding-bottom，而不是 head 的 margin ——
 *      margin 不在背景覆盖范围内，吸顶时那段缝会露出滚过的卡片；
 *   3. 负的左右外边距 + 等量左右内边距，抵消 .page 的 28rpx 内边距，
 *      让吸顶条横贯整屏。与 report 的 .report__sticky 是同一套做法。
 */
.board__group-sticky {
  position: sticky;
  top: 0;
  z-index: 2;
  background: var(--bg);
  margin-left: calc(-1 * var(--gap));
  margin-right: calc(-1 * var(--gap));
  padding-left: var(--gap);
  padding-right: var(--gap);
  padding-bottom: 12rpx;
}

/*
 * 分类标题行。分类色方块在最左，竖列扫读时形成一条颜色带。
 * 不做边框不做底 —— 分组之间的层级靠留白和方块的颜色区分，
 * 少一层描边观感更干净。
 */
.board__group-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
}

.board__group-title {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text-sub);
}

.board__group-count {
  flex-shrink: 0;
  font-size: var(--fs-caption);
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}

.board__group-arrow {
  flex-shrink: 0;
  width: 24rpx;
  font-size: var(--fs-micro);
  color: var(--muted);
}

/* ── 计划段的行 ────────────────────────────────────────────────── */

/*
 * 计划行是**只读**的：没有按压反馈、没有箭头、没有下划线。
 * 它长得像卡片但没有可点的意思 —— 用 .card--flat 保留卡片的排版，
 * 靠"什么都没绑"来传达只读，而不是靠灰掉（灰掉会被读成"暂时不可用"）。
 */
.board__plan {
  margin-bottom: var(--gap-sm);
}

.board__plan-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.board__plan-name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-title);
  font-weight: 600;
}

/*
 * 「主办 / 排期 / 本期 / 任务名」四行同构。
 * 标签固定宽度而不是靠 gap 顶开：四行的值要左边对齐成一列，
 * 否则「任务名」那行最长会把前面的标签挤窄，看起来像两种行。
 */
.board__plan-line {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 8rpx;
}

.board__plan-k {
  flex-shrink: 0;
  width: 84rpx;
  font-size: var(--fs-caption);
  color: var(--muted);
}

.board__plan-v {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-sub);
  color: var(--text-sub);
}
