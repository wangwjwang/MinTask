/**
 * miniprogram/app.wxss
 * ---------------------------------------------------------------------------
 * 全局样式。分四层：
 *   1. 设计令牌（CSS 变量）—— 颜色/圆角/间距/字号只在这里定义一次
 *   2. 基础布局类      —— .page / .card / .row 等骨架
 *   3. 组件类          —— .badge / .btn / .field 等可复用件
 *   4. 页面件          —— .summary / .seg / .pill / .chip 等页面级构件
 *
 * ★ 页面 WXSS 里不要再写死颜色值，一律用 var(--xxx)。
 *   否则改主题时要满项目搜索替换，必然漏。
 *
 * ★ 设计取向（v2）：结构学 1Password，手感学 IKEA。
 *   - 颜色稀缺：主色是**全站唯一的高饱和色**，只出现在实心按钮 / 当前页签 /
 *     可点链接上。状态色（红/黄/绿/蓝）语义不变，分类色只做小方块。
 *   - 区域靠底色对比分层，**全站不使用阴影**。阴影是通用卡片套件最典型的
 *     特征，去掉后更干净，也更接近参考图。
 *
 * ★ 改颜色时要一起改的地方（CSS 变量够不到，只能各处硬写）：
 *   1. utils/theme.js        —— `<slider activeColor>` 只吃十六进制字面量
 *   2. app.json              —— tabBar 的 color / selectedColor 是静态 JSON
 *   3. images/tabbar/*.png   —— 已经栅格化的图标，跑 `node scripts/gen-tabbar-icons.js`
 *                              重新生成（否则会出现"图标是旧蓝、文字是新蓝"）
 *   4. custom-tab-bar/index.wxss —— ★ 它的 var() 里都写了兜底字面色值，
 *                              同样要跟这里一起改（为什么带兜底，见该文件头部）
 * ---------------------------------------------------------------------------
 */

page {
  /* ── 主色 ── 全站唯一的高饱和色 */
  --primary: #2563EB;
  --primary-soft: #E8EFFC;
  --primary-dark: #1D4FC4;
  /* 「选中态背景」的语义别名。目前等同主色浅底，单独命名是为了防止
     以后有人把 --primary-soft 当成通用装饰底色去用 */
  --selected-bg: var(--primary-soft);

  /* ── 中性色 ── 底色带一丝暖意，刻意避开偏蓝的"后台管理系统灰" */
  --bg: #F5F3F1;
  --card: #FFFFFF;
  --text: #1A1D24;
  --text-sub: #5B6270;
  --muted: #8A8F99;
  --placeholder: #B8BCC4;
  /* 实心主色/危险色按钮上的文字色 */
  --on-solid: #FFFFFF;
  --border: #E9E7E4;
  --divider: #F2F0ED;

  /* ── 语义色（对应 shared/constants.js 的 *_TONE）──
     ★ 语义与 v1 完全一致，本次重构只调色值不改归属：
       红＝受阻/逾期，黄＝有风险/临期，绿＝已完成，蓝＝进行中 */
  --tone-ok: #12A150;
  --tone-ok-bg: #E7F7EE;
  --tone-warn: #D97706;
  --tone-warn-bg: #FEF4E6;
  --tone-danger: #DC2626;
  --tone-danger-bg: #FDECEB;
  /* 卡壳标记的描边 = --tone-danger 的 25% 透明度。
     ★ 必须在这里写十六进制/rgba 字面量，不能写 var(--tone-danger) ——
       WXSS 不支持 color-mix()，也没有透明色令牌可以引用。
       改 --tone-danger 时这一行要跟着手改。 */
  --tone-danger-border: rgba(220, 38, 38, 0.25);
  --tone-active: #2563EB;
  --tone-active-bg: #E8EFFC;
  --tone-done: #6B7280;
  --tone-done-bg: #EEF0F3;
  --tone-idle: #6B7280;
  --tone-idle-bg: #EEF0F3;

  /* ── 圆角 ── */
  --radius-sm: 12rpx;
  --radius: 24rpx;
  --radius-lg: 32rpx;
  --radius-full: 999rpx;

  /* ── 间距 ── */
  --gap-sm: 16rpx;
  --gap: 28rpx;
  --gap-lg: 40rpx;

  /* ── 字号 ──
     v1 的字号全挤在 22–32rpx 之间，没有层级。这里拉开差距。
     ★ 中文不加负字距：参考图的紧排是拉丁字母的排版手法，
       汉字施加负字距会让字面互相挤压。 */
  --fs-hero: 52rpx;
  --fs-title: 34rpx;
  --fs-body: 28rpx;
  --fs-sub: 26rpx;
  --fs-caption: 24rpx;
  --fs-micro: 22rpx;

  background: var(--bg);
  color: var(--text);
  font-size: var(--fs-body);
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

/* ─────────────────────────────────────────────────────────────────────────
   基础布局
   ───────────────────────────────────────────────────────────────────────── */

.page {
  min-height: 100vh;
  padding: var(--gap);
  box-sizing: border-box;
}

/* 底部有固定操作栏的页面用它，避免内容被按钮盖住 */
.page--with-footer {
  padding-bottom: 200rpx;
}

/*
 * Tab 页专用：让出底部自定义 tabBar 的高度。
 * ★ 原生 tabBar 会自动把页面顶上去，换成 custom 之后**不会**了 ——
 *   这一块必须由页面自己留，否则列表最后一条永久被挡在 tabBar 底下，
 *   而且滚到底也露不出来（页面已经到底了）。
 * ★ 高度与 custom-tab-bar/index.wxss 的 .tabbar 是一对，改要一起改。
 */
.page--tabbar {
  padding-bottom: calc(128rpx + env(safe-area-inset-bottom));
}

/*
 * ★ 这里原来还有一条 `.page--with-footer.page--tabbar`（两层让位叠加），
 *   唯一的使用者是「报任务」—— 它底部那条固定按钮栏 2026-10-03 改成了
 *   页面内的入口行，不再需要让位，规则随之删除。
 *   将来若真给 Tab 页加回固定操作栏，让位高度 = 两条栏之和。
 */

/* 卡片：靠底色对比从背景里浮起来，**不用阴影** */
.card {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: var(--gap);
  margin-bottom: var(--gap-sm);
}

.card--flat {
  border: 2rpx solid var(--border);
}

.row {
  display: flex;
  align-items: center;
}

.row--between {
  justify-content: space-between;
}

/* 顶对齐。卡片首行「方块 + 可折行标题 + 右上角标签」用这个，不用默认的居中对齐 */
.row--top {
  align-items: flex-start;
}

.row--wrap {
  flex-wrap: wrap;
}

.col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
  min-width: 0; /* 允许子元素内的文字省略号生效 */
}

/* ─────────────────────────────────────────────────────────────────────────
   文字
   ───────────────────────────────────────────────────────────────────────── */

.t-title {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--text);
}

.t-sub {
  font-size: var(--fs-sub);
  color: var(--text-sub);
}

.t-muted {
  font-size: var(--fs-caption);
  color: var(--muted);
}

.t-mono {
  font-variant-numeric: tabular-nums;
}

/* 单行省略 */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 两行省略 */
.ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 区块标题 */
.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 16rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text);
}

.section-title__count {
  font-size: var(--fs-caption);
  font-weight: 400;
  color: var(--muted);
}

/* 表单分区标题：在卡片之上给出结构，让长表单不再是一堵平铺的墙 */
.form-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 20rpx 4rpx 12rpx;
  font-size: var(--fs-sub);
  font-weight: 600;
  color: var(--text-sub);
}

.form-head:first-child {
  margin-top: 0;
}

/* ─────────────────────────────────────────────────────────────────────────
   徽标 —— 配色 key 来自 shared/constants.js 的 *_TONE
   形式是「浅底 + 深字」的胶囊，与分类标记的「实心小方块」刻意区分开
   ───────────────────────────────────────────────────────────────────────── */

.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  font-size: var(--fs-micro);
  line-height: 1.6;
  white-space: nowrap;
}

.badge--ok      { color: var(--tone-ok);      background: var(--tone-ok-bg); }
.badge--warn    { color: var(--tone-warn);    background: var(--tone-warn-bg); }
.badge--danger  { color: var(--tone-danger);  background: var(--tone-danger-bg); }
.badge--active  { color: var(--tone-active);  background: var(--tone-active-bg); }
.badge--done    { color: var(--tone-done);    background: var(--tone-done-bg); }
.badge--idle    { color: var(--tone-idle);    background: var(--tone-idle-bg); }

.badge--outline {
  background: transparent;
  border: 2rpx solid currentColor;
}

/* ─────────────────────────────────────────────────────────────────────────
   按钮
   ───────────────────────────────────────────────────────────────────────── */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius);
  font-size: var(--fs-body);
  font-weight: 500;
  border: none;
  line-height: 1;
}

.btn::after {
  border: none; /* 去掉小程序 button 默认边框 */
}

.btn--primary {
  background: var(--primary);
  color: var(--on-solid);
}

.btn--primary:active {
  background: var(--primary-dark);
}

.btn--ghost {
  background: var(--card);
  color: var(--primary);
  border: 2rpx solid var(--primary);
}

.btn--plain {
  background: var(--card);
  color: var(--text-sub);
  border: 2rpx solid var(--border);
}

.btn--danger {
  background: var(--tone-danger);
  color: var(--on-solid);
}

.btn[disabled],
.btn--disabled {
  opacity: 0.45;
}

.btn--sm {
  height: 64rpx;
  font-size: var(--fs-sub);
  padding: 0 24rpx;
}

/* 底部固定操作栏 */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx var(--gap) calc(16rpx + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 2rpx solid var(--border);
  z-index: 10;
}

/*
 * ★ 这里原来还有一条 `.footer-bar--tabbar`（把操作栏抬到自定义 tabBar 之上），
 *   唯一的使用者是「报任务」，2026-10-03 那条栏改成了页面内的入口行，规则删除。
 *   将来若要给 Tab 页加固定操作栏：z-index 不用抢（tabBar 是 100，本来就压在上面），
 *   但 bottom 要抬到 calc(100rpx + env(safe-area-inset-bottom))，
 *   否则操作栏会被 tabBar 盖住一截，看起来像按钮被削了一半。
 */

/* ─────────────────────────────────────────────────────────────────────────
   表单
   ───────────────────────────────────────────────────────────────────────── */

.field {
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--divider);
}

.field:last-child {
  border-bottom: none;
}

.field__label {
  font-size: var(--fs-sub);
  color: var(--text-sub);
  margin-bottom: 12rpx;
}

.field__label--required::after {
  content: ' *';
  color: var(--tone-danger);
}

/*
 * ★ 文本输入改为「凹槽式填充框」：浅底 + 圆角，与选择器（行式 + 箭头）形成
 *   强对比 —— 用户一眼就能区分"在这里打字"和"点我选"。
 *   填充用 --bg（页面底色），不是阴影：靠底色对比浮起来，符合全站"不用阴影"的取向。
 */
.field__input {
  width: 100%;
  box-sizing: border-box;
  background: var(--bg);
  border-radius: var(--radius-sm);
  padding: 22rpx 24rpx;
  font-size: var(--fs-body);
  color: var(--text);
  min-height: 52rpx;
  line-height: 1.4;
}

.field__textarea {
  width: 100%;
  box-sizing: border-box;
  background: var(--bg);
  border-radius: var(--radius-sm);
  padding: 22rpx 24rpx;
  min-height: 200rpx;
  font-size: var(--fs-body);
  color: var(--text);
  line-height: 1.6;
}

.field__placeholder {
  color: var(--placeholder);
}

/*
 * 可点击的选择行（右侧带箭头）
 *
 * ★ width: 100% 是必需的：这个行通常被包在 <picker> 里，而 picker 是行内块，
 *   flex 容器不撑开就会缩成内容宽度。
 *   放在全局而不是各页面，是因为 field-picker 组件的样式不外流到页面
 *   （样式隔离单向），而全局类能穿透进组件（组件都开了 addGlobalClass）。
 *   这样组件内和页面内联的 picker 行共用同一份定义，不必各抄一遍。
 */
.field--picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  box-sizing: border-box;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--divider);
}

.field--picker:active {
  background: var(--divider);
}

/* picker 行左侧的标签。flex:1 让值靠右，margin 清掉 .field__label 的下边距 */
.picker__label {
  flex: 1;
  margin-bottom: 0;
  margin-right: 24rpx;
}

.field__value {
  font-size: var(--fs-body);
  color: var(--text);
}

.field__value--empty {
  color: var(--placeholder);
}

/*
 * 选择器右侧的箭头：放大加粗，让它明确读作"可点开的入口"，
 * 与左侧输入框的"打字凹槽"形成清晰的形态对比。
 */
.field__arrow {
  color: var(--muted);
  font-size: 32rpx;
  font-weight: 600;
  margin-left: 12rpx;
  line-height: 1;
}

/* ─────────────────────────────────────────────────────────────────────────
   进度条
   ───────────────────────────────────────────────────────────────────────── */

.progress {
  height: 12rpx;
  border-radius: var(--radius-full);
  background: var(--divider);
  overflow: hidden;
}

.progress__bar {
  height: 100%;
  border-radius: var(--radius-full);
  background: var(--primary);
  transition: width 0.3s ease;
}

.progress__bar--done {
  background: var(--tone-ok);
}

.progress__bar--danger {
  background: var(--tone-danger);
}

/* ─────────────────────────────────────────────────────────────────────────
   空状态 / 加载
   ───────────────────────────────────────────────────────────────────────── */

.empty {
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty__title {
  font-size: var(--fs-body);
  color: var(--muted);
  margin-bottom: 12rpx;
}

.empty__hint {
  font-size: var(--fs-caption);
  color: var(--placeholder);
}

.loading-block {
  padding: 80rpx;
  text-align: center;
  color: var(--muted);
  font-size: var(--fs-sub);
}

/* ─────────────────────────────────────────────────────────────────────────
   卡壳高亮 —— 需求要求「卡壳任务在卡片上高亮标记」
   ───────────────────────────────────────────────────────────────────────── */

.blocker-flag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  font-size: var(--fs-micro);
  color: var(--tone-danger);
  background: var(--tone-danger-bg);
  border: 2rpx solid var(--tone-danger-border);
}

.card--blocked {
  border-left: 8rpx solid var(--tone-danger);
}

/* ─────────────────────────────────────────────────────────────────────────
   通用小件
   ───────────────────────────────────────────────────────────────────────── */

.divider {
  height: 2rpx;
  background: var(--divider);
  margin: var(--gap-sm) 0;
}

.tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
  font-size: var(--fs-micro);
  color: var(--text-sub);
  background: var(--divider);
}

.hit {
  transition: opacity 0.15s ease;
}

.hit:active {
  opacity: 0.6;
}

/* ─────────────────────────────────────────────────────────────────────────
   页内信息块 —— 替代「页内大标题」

   11 个页面全靠微信原生导航栏标题，页内再放一个「报任务」大标题会和导航栏
   重复。所以这个位置放**信息**不放页面名：报任务是「姓名 + 统计」，人员看板
   是「共 10 人」。导航栏给上下文，这里给内容。
   （1Password 首页正是这个结构：导航层 Home，页内大标题 John Smith）
   ───────────────────────────────────────────────────────────────────────── */

.summary {
  padding: 8rpx 4rpx var(--gap);
}

.summary__value {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  font-size: var(--fs-hero);
  font-weight: 700;
  line-height: 1.15;
  color: var(--text);
}

.summary__unit {
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--text-sub);
}

.summary__stats {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx 24rpx;
  margin-top: 12rpx;
  font-size: var(--fs-sub);
  color: var(--muted);
}

/* ─────────────────────────────────────────────────────────────────────────
   统计胶囊 —— 取自参考图 IKEA 顶部那排胶囊块
   用于任务看板顶部的「共 61 项 / 卡壳 3 / 逾期 5」
   ───────────────────────────────────────────────────────────────────────── */

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pill {
  display: inline-flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-full);
  background: var(--card);
  font-size: var(--fs-caption);
  color: var(--text-sub);
}

.pill__value {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}

.pill--danger .pill__value {
  color: var(--tone-danger);
}

.pill--warn .pill__value {
  color: var(--tone-warn);
}

/* 胶囊被点开置顶时的激活态：蓝环（用 box-shadow 环绕，不改变盒模型宽度、挤动邻居胶囊） */
.pill--active {
  font-weight: 600;
  box-shadow: 0 0 0 2rpx var(--accent, #2f6fed);
}

/* ─────────────────────────────────────────────────────────────────────────
   入口卡 —— 整张卡片可点的下钻入口
   报任务的「新加入协办」与改任务的「退出协办」共用。
   结构 = .card.card--flat + 左侧标题/说明 + 右侧箭头（箭头用 .field__arrow）。
   ───────────────────────────────────────────────────────────────────────── */

.entry-card {
  margin-top: var(--gap);
}

/*
 * 箭头在这里放大到 40rpx。★ 40rpx 不是字号，是图标尺寸 ——
 * 它是可点入口的指示符（和 tabBar 图标同类），不参与文字层级，
 * 所以刻意不套 --fs-* 令牌，避免以后有人按字号体系去"修正"它。
 */
.entry-card .field__arrow {
  font-size: 40rpx;
}

/* ─────────────────────────────────────────────────────────────────────────
   分段切换 —— 取自参考图 IKEA 顶部「Rooms │ Products」页签
   用于任务看板切换阶段。下划线指示当前项。
   ───────────────────────────────────────────────────────────────────────── */

.seg {
  display: flex;
  border-bottom: 2rpx solid var(--border);
}

.seg__item {
  position: relative;
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 6rpx;
  padding: 20rpx 0 18rpx;
  font-size: var(--fs-body);
  color: var(--muted);
}

.seg__item--on {
  color: var(--text);
  font-weight: 600;
}

/* 选中下划线。bottom 取负值盖住 .seg 自己的那条底线 */
.seg__item--on::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -2rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--primary);
}

.seg__count {
  font-size: var(--fs-micro);
  font-weight: 400;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}

/* ─────────────────────────────────────────────────────────────────────────
   分类标记 —— 实心小方块

   ★ 形式是硬约束：分类色**只以小方块出现**，绝不作为背景。
     状态徽标是「浅底＋深字」胶囊，这里是「实心方块」，形式不同，
     所以即便色相接近也不会被误读成状态。
     方块的具体颜色由 utils/theme.js 的 categoryColor() 内联给出。
   ───────────────────────────────────────────────────────────────────────── */

.chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.chip__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
  background: var(--placeholder); /* theme.js 取不到色时的兜底 */
}

/*
 * 方块贴在 --fs-title 级标题的**首行中线**上。
 * 标题可能折成两行（列表卡最多两行、详情页不截断），
 * 所以不能靠 align-items: center —— 那会让方块掉到两行中间。
 * 偏移量按 --fs-title（34rpx）× 1.5 行高算：（51 − 16）÷ 2 ≈ 18rpx。
 * 任务卡与任务详情共用，改字号时这两处一起动。
 */
.chip__dot--lead {
  margin-top: 18rpx;
}

.chip__text {
  font-size: var(--fs-caption);
  color: var(--text-sub);
}

/* ─────────────────────────────────────────────────────────────────────────
   成员卡片 —— 人员看板与认领页共用

   放在全局而不是 people 页：认领页也要用同一张卡，而页面 WXSS 不跨页生效
   （样式隔离），共享定义只能上提。与 .field--picker 是同一类处理。
   ───────────────────────────────────────────────────────────────────────── */

.member {
  display: flex;
  align-items: center;
}

.member--me {
  border-left: 8rpx solid var(--primary);
}

.member--unclaimed {
  opacity: 0.6;
}

/*
 * 头像用姓名文字代替图片：团队 10 余人、名单固定，
 * 引入头像图片反而要多一套上传/存储流程，收益不值。
 */
.member__avatar {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: var(--fs-caption);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: 1.2;
  overflow: hidden;
  padding: 0 6rpx;
  box-sizing: border-box;
}

.member__avatar--off {
  background: var(--divider);
  color: var(--muted);
}

.member__main {
  min-width: 0;
}

.member__name {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--text);
}

.member__tag {
  margin-left: 10rpx;
}

.member__dept {
  margin-top: 6rpx;
}

/* ── 负载数字（只有人员看板会渲染）── */

.member__stats {
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 12rpx;
}

.member__stat {
  font-size: var(--fs-caption);
  color: var(--muted);
}

.member__num {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}

.member__stat--open .member__num {
  color: var(--primary);
}

.member__stat--done .member__num {
  color: var(--tone-ok);
}

/*
 * 近两周动静。单独占一行 —— 上面的数字是历史累计，这个是近期活跃度，
 * 口径不同，混进同一行会被当成同一维度的数字。（同 people/index.wxml）
 */
.member__recent {
  margin-top: 8rpx;
  font-size: var(--fs-caption);
  color: var(--text-sub);
}

/* 没动静的人弱化到底，别和"有进展"抢注意力 */
.member__recent--none {
  color: var(--muted);
}

/* ─────────────────────────────────────────────────────────────────────────
   可勾选的成员行 —— 报任务与改任务共用

   与上面的 .member 卡片的区别：这里是**表单内的紧凑行**，没有头像，
   靠分隔线连成一张列表。两者形式不同、用途不同，所以不合并。
   但 .create__member* 与 .edit__member* 曾是逐字相同的两份，合到这里。
   ───────────────────────────────────────────────────────────────────────── */

.pick-row {
  display: flex;
  align-items: center;
  padding: 22rpx 4rpx;
  border-bottom: 2rpx solid var(--divider);
}

.pick-row:last-child {
  border-bottom: none;
}

/* 选中行整体转主色，姓名与勾随之变色（部门用 .t-muted 覆盖回灰） */
.pick-row--on {
  color: var(--primary);
}

.pick-row__name {
  font-size: var(--fs-body);
}

.pick-row__dept {
  margin-left: 12rpx;
}

/*
 * 勾选标记 —— 认领页的成员卡、报任务/改任务的成员行共用一个勾。
 * 三处原先各写了一份（34/32/32rpx），现在统一为 --fs-title。
 */
.pick__check {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: var(--primary);
  font-size: var(--fs-title);
  font-weight: 600;
}

/* ─────────────────────────────────────────────────────────────────────────
   编辑页通用件 —— 计划（plan-edit）与需求（demand-edit）共用

   与 .member / .field--picker 同一类处理：页面 WXSS 不跨页生效，两页要
   同一套样式就只能上提。原样从 pages/plan-edit/index.wxss 搬过来，
   那边一行都不用改。
   ───────────────────────────────────────────────────────────────────────── */

.edit__tip {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-sm);
  background: var(--bg);
  line-height: 1.6;
}

/* ── 只读视图：看的人不打算改它，就别摆表格 ── */

.edit__ro-head {
  align-items: flex-start;
  margin-bottom: 8rpx;
}

/*
 * 标签列定宽，值从左边缘对齐 —— 与任务看板计划行（.board__plan-line）
 * 同一套排法：两处显示的是同一批字段，换页看时不该重新找位置。
 */
.edit__ro-line {
  display: flex;
  align-items: baseline;
  margin-top: 16rpx;
}

.edit__ro-k {
  width: 84rpx;
  flex: none;
  font-size: var(--fs-caption);
  color: var(--muted);
}

.edit__ro-v {
  flex: 1;
  font-size: var(--fs-body);
  line-height: 1.5;
  word-break: break-all;
}

.edit__ro-detail {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--divider);
  line-height: 1.7;
  white-space: pre-wrap;
}

/* ── 危险区：停用 / 关闭 / 删除 ── */

.edit__danger-zone {
  margin-bottom: var(--gap);
}

.edit__danger-tip {
  line-height: 1.6;
}

/*
 * 停用/重开是可逆动作，用普通描边按钮；
 * 删除/关闭不可逆，用红字 —— 但不填充实心：
 * 底栏已经有一个实心主色的「保存修改」，再来一个实心红，
 * 两个实心按钮会互相抢视觉重心，而删除恰恰是最不该被误点的那一个。
 */
.edit__state {
  width: 100%;
  margin-top: 20rpx;
}

.edit__danger {
  width: 100%;
  margin-top: 16rpx;
  color: var(--tone-danger);
  border-color: var(--tone-danger);
}
