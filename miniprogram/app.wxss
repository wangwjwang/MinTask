/**
 * miniprogram/app.wxss
 * ---------------------------------------------------------------------------
 * 全局样式。分三层：
 *   1. 设计令牌（CSS 变量）—— 颜色/圆角/间距只在这里定义一次
 *   2. 基础布局类      —— .page / .card / .row 等骨架
 *   3. 组件类          —— .badge / .btn / .field 等可复用件
 *
 * ★ 页面 WXSS 里不要再写死颜色值，一律用 var(--xxx)。
 *   否则改主题时要满项目搜索替换，必然漏。
 * ---------------------------------------------------------------------------
 */

page {
  /* ── 主色 ── */
  --primary: #2b6cff;
  --primary-soft: #eaf1ff;
  --primary-dark: #1b52d0;

  /* ── 中性色 ── */
  --bg: #f4f5f7;
  --card: #ffffff;
  --text: #1a1d24;
  --text-sub: #5b6270;
  --muted: #8a8f99;
  --border: #e8eaee;
  --divider: #f0f1f4;

  /* ── 语义色（对应 constants.js 的 *_TONE）── */
  --tone-ok: #12a150;
  --tone-ok-bg: #e7f7ee;
  --tone-warn: #d97706;
  --tone-warn-bg: #fef4e6;
  --tone-danger: #dc2626;
  --tone-danger-bg: #fdeceb;
  --tone-active: #2b6cff;
  --tone-active-bg: #eaf1ff;
  --tone-done: #6b7280;
  --tone-done-bg: #eef0f3;
  --tone-idle: #6b7280;
  --tone-idle-bg: #eef0f3;

  /* ── 尺寸 ── */
  --radius: 16rpx;
  --radius-sm: 8rpx;
  --radius-lg: 24rpx;
  --gap: 24rpx;
  --gap-sm: 16rpx;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

/* ─────────────────────────────────────────────────────────────────────────
   基础布局
   ───────────────────────────────────────────────────────────────────────── */

.page {
  min-height: 100vh;
  padding: var(--gap);
  box-sizing: border-box;
}

/* 底部有固定操作栏的页面用它，避免内容被按钮盖住 */
.page--with-footer {
  padding-bottom: 180rpx;
}

.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: var(--gap);
  margin-bottom: var(--gap-sm);
  box-shadow: 0 2rpx 12rpx rgba(16, 24, 40, 0.04);
}

.card--flat {
  box-shadow: none;
  border: 2rpx solid var(--border);
}

.row {
  display: flex;
  align-items: center;
}

.row--between {
  justify-content: space-between;
}

.row--wrap {
  flex-wrap: wrap;
}

.col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
  min-width: 0; /* 允许子元素内的文字省略号生效 */
}

/* ─────────────────────────────────────────────────────────────────────────
   文字
   ───────────────────────────────────────────────────────────────────────── */

.t-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.t-sub {
  font-size: 26rpx;
  color: var(--text-sub);
}

.t-muted {
  font-size: 24rpx;
  color: var(--muted);
}

.t-mono {
  font-variant-numeric: tabular-nums;
}

/* 单行省略 */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 两行省略 */
.ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 区块标题 */
.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.section-title__count {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--muted);
}

/* ─────────────────────────────────────────────────────────────────────────
   徽标 —— 配色 key 来自 shared/constants.js 的 *_TONE
   ───────────────────────────────────────────────────────────────────────── */

.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.6;
  white-space: nowrap;
}

.badge--ok      { color: var(--tone-ok);      background: var(--tone-ok-bg); }
.badge--warn    { color: var(--tone-warn);    background: var(--tone-warn-bg); }
.badge--danger  { color: var(--tone-danger);  background: var(--tone-danger-bg); }
.badge--active  { color: var(--tone-active);  background: var(--tone-active-bg); }
.badge--done    { color: var(--tone-done);    background: var(--tone-done-bg); }
.badge--idle    { color: var(--tone-idle);    background: var(--tone-idle-bg); }

.badge--outline {
  background: transparent;
  border: 2rpx solid currentColor;
}

/* ─────────────────────────────────────────────────────────────────────────
   按钮
   ───────────────────────────────────────────────────────────────────────── */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius);
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  line-height: 1;
}

.btn::after {
  border: none; /* 去掉小程序 button 默认边框 */
}

.btn--primary {
  background: var(--primary);
  color: #fff;
}

.btn--primary:active {
  background: var(--primary-dark);
}

.btn--ghost {
  background: var(--card);
  color: var(--primary);
  border: 2rpx solid var(--primary);
}

.btn--plain {
  background: var(--card);
  color: var(--text-sub);
  border: 2rpx solid var(--border);
}

.btn--danger {
  background: var(--tone-danger);
  color: #fff;
}

.btn[disabled],
.btn--disabled {
  opacity: 0.45;
}

.btn--sm {
  height: 64rpx;
  font-size: 26rpx;
  padding: 0 24rpx;
}

/* 底部固定操作栏 */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx var(--gap) calc(16rpx + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 2rpx solid var(--border);
  z-index: 10;
}

/* ─────────────────────────────────────────────────────────────────────────
   表单
   ───────────────────────────────────────────────────────────────────────── */

.field {
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--divider);
}

.field:last-child {
  border-bottom: none;
}

.field__label {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 12rpx;
}

.field__label--required::after {
  content: ' *';
  color: var(--tone-danger);
}

.field__input {
  width: 100%;
  font-size: 30rpx;
  color: var(--text);
  min-height: 48rpx;
}

.field__textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 30rpx;
  color: var(--text);
  line-height: 1.6;
}

.field__placeholder {
  color: #b8bcc4;
}

/* 可点击的选择行（右侧带箭头） */
.field--picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--divider);
}

.field--picker:active {
  background: var(--divider);
}

.field__value {
  font-size: 30rpx;
  color: var(--text);
}

.field__value--empty {
  color: #b8bcc4;
}

.field__arrow {
  color: var(--muted);
  font-size: 26rpx;
  margin-left: 12rpx;
}

/* ─────────────────────────────────────────────────────────────────────────
   进度条
   ───────────────────────────────────────────────────────────────────────── */

.progress {
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--divider);
  overflow: hidden;
}

.progress__bar {
  height: 100%;
  border-radius: 999rpx;
  background: var(--primary);
  transition: width 0.3s ease;
}

.progress__bar--done {
  background: var(--tone-ok);
}

.progress__bar--danger {
  background: var(--tone-danger);
}

/* ─────────────────────────────────────────────────────────────────────────
   空状态 / 加载
   ───────────────────────────────────────────────────────────────────────── */

.empty {
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty__title {
  font-size: 28rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.empty__hint {
  font-size: 24rpx;
  color: #b8bcc4;
}

.loading-block {
  padding: 80rpx;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}

/* ─────────────────────────────────────────────────────────────────────────
   卡壳高亮 —— 需求要求「卡壳任务在卡片上高亮标记」
   ───────────────────────────────────────────────────────────────────────── */

.blocker-flag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--tone-danger);
  background: var(--tone-danger-bg);
  border: 2rpx solid rgba(220, 38, 38, 0.25);
}

.card--blocked {
  border-left: 8rpx solid var(--tone-danger);
}

/* ─────────────────────────────────────────────────────────────────────────
   通用小件
   ───────────────────────────────────────────────────────────────────────── */

.divider {
  height: 2rpx;
  background: var(--divider);
  margin: var(--gap-sm) 0;
}

.tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  color: var(--text-sub);
  background: var(--divider);
}

.hit {
  transition: opacity 0.15s ease;
}

.hit:active {
  opacity: 0.6;
}
