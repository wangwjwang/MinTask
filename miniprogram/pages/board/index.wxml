<!--
  pages/board Tab3 任务看板

  ★ v2 结构：统计胶囊 → 分段切换 → 单一纵向列表。
    取代了原来「三列横向滚动 + 列内纵向滚动」的嵌套滚动。

  ★ v2.3：最左那一段换成「周期性计划」，列的是**计划本身**（全体成员的，
    只读），不再是计划生成出来的任务。
    两个分段两套渲染：
      · 计划段   —— 平铺计划，同一主办人的排在一起，**不可点**；
      · 阶段段   —— 按任务分类分组，每组可折叠。
    ★ 内容区那条 wx:if 链的第一条必须带上 plans.length：只判 segmentTab 的话，
      计划段为空时会渲染一个空视图，后面的 wx:elif / wx:else 永远轮不到，
      「还没有人建过计划」就永远出不来。
    ★ 链中间不能插注释（见 update 页的告示），所以说明全写在这里。

  ★ v2.2：支持横向滑动切换分段（左右滑 = 切到相邻分段，到头停住不循环）。
    绑在页面根节点上，手在列表任意位置起划都算；判据在 utils/swipe.js。
    ★ 认的是**首动方向**（touchmove 定下就锁定）：起手往纵向走的，一律当成
      滚页面，后面横向偏得再多也不切段。只看终点的话，「斜着往下滚」会被
      误判成横滑 —— 2026-10-03 实测就是这个毛病。
-->
<view
  class="page page--tabbar"
  bindtouchstart="onTouchStart"
  bindtouchmove="onTouchMove"
  bindtouchcancel="onTouchCancel"
  bindtouchend="onTouchEnd"
>

  <!-- ── 汇总统计（IKEA 参考图顶部那排胶囊）────────────────────── -->
  <view class="board__summary">
    <view class="pill-row">
      <view class="pill">共 <text class="pill__value">{{stats.total}}</text> 项</view>
      <view class="pill {{stats.blocked ? 'pill--danger' : ''}} {{sortKey === 'blocked' ? 'pill--active' : ''}}" bindtap="onBlockedTap">
        卡壳 <text class="pill__value">{{stats.blocked}}</text>
      </view>
      <view class="pill {{stats.overdue ? 'pill--warn' : ''}} {{sortKey === 'overdue' ? 'pill--active' : ''}}" bindtap="onOverdueTap">
        逾期 <text class="pill__value">{{stats.overdue}}</text>
      </view>
    </view>
  </view>

  <!--
    ── 分段切换 ──────────────────────────────────────────────────
    取自参考图 IKEA 顶部「Rooms │ Products」页签：下划线指示当前项。
    每段带计数 —— 一次只显示一段，靠计数保住"看板全貌"。
    ★ 三段计数之和会大于顶部「共 N 项」：周期任务同时算在它所属的
      阶段段里，分段不是一组互斥的阶段。见 index.js 文件头。
    ★ 这里原来还有一行「全部分类」筛选胶囊（2026-10-03 用户拍板删除）：
      任务本来就按分类分了组，组标题吸顶、还各带条数，"底下都能看全"，
      筛选只是个多余的隐形状态 —— 筛着某个分类去别的页转一圈回来，
      看板只剩几条，容易以为数据丢了。
  -->
  <view class="seg board__seg">
    <view
      wx:for="{{tabs}}"
      wx:key="seg"
      class="seg__item {{segmentTab === item.seg ? 'seg__item--on' : ''}} hit"
      data-segment="{{item.seg}}"
      bindtap="onSegmentTap"
    >
      <text>{{item.seg}}</text>
      <text class="seg__count">{{item.count}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-block">正在加载看板…</view>

  <block wx:else>
    <view wx:if="{{segmentTab === '周期性计划' && plans.length}}">
      <!--
        计划段：平铺全体成员的计划，顺序在 index.js 里排好（同一主办人的连着）。
        ★ 点一行进 plan-edit 看那一份（2026-10-03 用户要求「能点进去看、
          只是不给改」）。给不给改由那一页自己判 canEdit：自己的计划落进
          表单，别人的落进只读摘要 —— 看板不复制这份判断。
        ★ 仍然不是 task-card：列的是计划，不是任务；用任务卡片的样式
          会让人以为点进去是任务详情。
        ★ 目标是 plan-edit 而不是新建一个详情页：计划只有这一个出口，
          "看"和"改"共用一页、由同一个 canEdit 分流，才不会出现
          详情页说"只读"、隔壁页却给改的错位。
      -->
      <view
        wx:for="{{plans}}"
        wx:for-item="plan"
        wx:key="_id"
        class="card card--flat board__plan hit"
        data-id="{{plan._id}}"
        bindtap="onPlanTap"
      >
        <view class="board__plan-head">
          <text class="board__plan-name ellipsis">{{plan.name}}</text>
          <text class="badge {{plan._stateTone}}">{{plan._stateText}}</text>
        </view>

        <view class="board__plan-line">
          <text class="board__plan-k">主办</text>
          <text class="board__plan-v">{{plan.ownerName || '—'}}</text>
        </view>

        <view class="board__plan-line">
          <text class="board__plan-k">排期</text>
          <text class="board__plan-v">{{plan._schedule || '—'}}</text>
        </view>

        <view class="board__plan-line">
          <text class="board__plan-k">本期</text>
          <text class="board__plan-v t-mono">{{plan._periodText || '—'}}</text>
        </view>

        <view class="board__plan-line">
          <text class="board__plan-k">任务名</text>
          <text class="board__plan-v">{{plan._taskName || '—'}}</text>
        </view>
      </view>
    </view>

    <block wx:elif="{{groups.length || pinned.length}}">
      <!--
        置顶区：点「卡壳 / 逾期」胶囊后，命中的任务从各分类组里被抽出，
        单独排在列表最顶部（字面意义"调到最上头"）；下方分类组不再含它们。
        再点一次胶囊（取消置顶）→ sortKey 清空 → pinned 为空 → 恢复默认分组视图。
      -->
      <view wx:if="{{pinned.length}}" class="board__pinned">
        <view class="board__pinned-head">
          <view class="chip__dot chip__dot--pin"></view>
          <text class="board__pinned-title">{{pinnedLabel}}置顶</text>
          <text class="board__pinned-count">{{pinned.length}}</text>
        </view>
        <task-card
          wx:for="{{pinned}}"
          wx:for-item="task"
          wx:key="_id"
          task="{{task}}"
          bind:tap="onTaskTap"
        />
      </view>

      <!-- 当前分段内按任务分类分组，每组可点标题折叠 -->
      <view
        wx:for="{{groups}}"
        wx:for-item="group"
        wx:key="key"
        class="board__group"
      >
        <!-- 外层负责吸顶：吸附范围就是本组，滚过本组会被下一组顶走 -->
        <view class="board__group-sticky">
          <view
            class="board__group-head hit"
            data-category="{{group.category}}"
            bindtap="onToggleGroup"
          >
            <view class="chip__dot" style="background: {{group.color}}"></view>
            <text class="board__group-title ellipsis">{{group.category}}</text>
            <text class="board__group-count">{{group.tasks.length}}</text>
            <text class="board__group-arrow">{{group.collapsed ? '▸' : '▾'}}</text>
          </view>
        </view>

        <block wx:if="{{!group.collapsed}}">
          <task-card
            wx:for="{{group.tasks}}"
            wx:for-item="task"
            wx:key="_id"
            task="{{task}}"
            bind:tap="onTaskTap"
          />
        </block>
      </view>
    </block>

    <!--
      空态文案由 viewFor 按当前分段与筛选算好（data.empty）——
      计划段该说「还没有人建过计划」，阶段段才是「这一段下没有任务」，
      两段共用一句话等于让前者一直等一个不会出现的任务。
    -->
    <empty-state wx:else title="{{empty.title}}" hint="{{empty.hint}}" />
  </block>
</view>
