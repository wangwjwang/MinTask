/* pages/leave */

.leave__intro {
  margin-bottom: var(--gap);
}

/*
 * 卡片与按钮叠放：task-card 自带 margin-bottom，
 * 这里把按钮上移，让它在视觉上归属上方那张卡片。
 * （与 pages/join 的 .join__item / .join__btn 同款。页面 WXSS 不跨页，
 *   所以这两个文件各留一份是必要的，不算重复定义。）
 */
.leave__item {
  position: relative;
}

.leave__btn {
  display: flex;
  width: 100%;
  margin: -8rpx 0 24rpx;
}
