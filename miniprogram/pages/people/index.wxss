/* pages/people 人员看板 */

/*
 * 未认领人数是可点的（点了复制名单发给同事催认领），
 * 所以在信息块里用主色 —— 主色在全站只表示"这个东西可以点"。
 * 原先用的 --tone-warn 是"有风险"的语义，认领还没完成不算是风险。
 */
.people__unclaimed {
  color: var(--primary);
}

/* ── 管理员：重新关联历史数据 ── */

.people__admin {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx dashed var(--border);
  border-radius: var(--radius-sm);
  font-size: var(--fs-sub);
  color: var(--tone-active);
}

.people__admin-sub {
  font-size: var(--fs-micro);
  color: var(--muted);
}

/*
 * ★ 成员卡片（.member / .member__avatar / …）已上提到 app.wxss。
 *   认领页也要用同一张卡，而页面 WXSS 不跨页生效（样式隔离），
 *   所以共享定义只能放全局。与 .field--picker 是同一类处理。
 */
