/* pages/task-edit */

/*
 * .field--picker / .picker__label 已上提到 app.wxss ——
 * 本页原先抄了一份和 field-picker 组件完全相同的定义，现已删除。
 */

.edit__tip {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-sm);
  background: var(--bg);
  line-height: 1.6;
}

/* ── 协办人管理面板 ── */

.edit__members {
  margin-top: 8rpx;
  border-top: 2rpx solid var(--divider);
  padding-top: 8rpx;
  max-height: 640rpx;
  overflow-y: auto;
}

/*
 * ★ 成员行（.pick-row 系列）与勾选标记（.pick__check）已上提到 app.wxss。
 *   本页原先抄了一份与报任务页逐字相同的 .edit__member*，现已删除。
 */

/* ── 底部按钮组 ── */

.edit__footer {
  gap: 16rpx;
}

.edit__reset {
  width: 180rpx;
  flex-shrink: 0;
}

/* ── 危险区：删除任务 ── */

.edit__danger-zone {
  margin-top: var(--gap);
}

.edit__danger-tip {
  line-height: 1.6;
}

/*
 * 红描边不填充 —— 底栏已经有一个实心主色的「保存」，
 * 再来一个实心红，两个实心按钮会互相抢视觉重心，
 * 而删除恰恰是最不该被误点的那一个。
 */
.edit__danger {
  width: 100%;
  margin-top: 20rpx;
  color: var(--tone-danger);
  background: var(--card);
  border: 2rpx solid var(--tone-danger);
}
