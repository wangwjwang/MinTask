<!--
  pages/board Tab3 任务看板

  ★ v2 结构：统计胶囊 → 分类筛选 → 分段切换 → 单一纵向列表。
    取代了原来「三列横向滚动 + 列内纵向滚动」的嵌套滚动。

  ★ v2.1：分段换成 周期性 / 进行中 / 已完成，「未开始」不再成段。
    两个分段两套渲染：
      · 周期性段 —— 平铺，按周期（每周→每月→每季→每年）排开，不分组；
      · 阶段段   —— 按任务分类分组，每组可折叠。
    ★ 内容区那条 wx:if 链的第一条必须带上 flat.length：只判 segmentTab 的话，
      周期性段为空时会渲染一个空视图，后面的 wx:elif / wx:else 永远轮不到，
      「这一段下没有任务」就永远出不来。
    ★ 链中间不能插注释（见 update 页的告示），所以说明全写在这里。
-->
<view class="page">

  <!-- ── 汇总统计（IKEA 参考图顶部那排胶囊）────────────────────── -->
  <view class="board__summary">
    <view class="pill-row">
      <view class="pill">共 <text class="pill__value">{{stats.total}}</text> 项</view>
      <view class="pill {{stats.blocked ? 'pill--danger' : ''}}" bindtap="onBlockedTap">
        卡壳 <text class="pill__value">{{stats.blocked}}</text>
      </view>
      <view class="pill {{stats.overdue ? 'pill--warn' : ''}}">
        逾期 <text class="pill__value">{{stats.overdue}}</text>
      </view>
    </view>
  </view>

  <!-- ── 分类筛选 ──────────────────────────────────────────────── -->
  <picker mode="selector" range="{{categoryOptions}}" bindchange="onFilterChange">
    <view class="filter-pill board__filter hit">
      <text class="filter-pill__label">{{filterCategory || '全部分类'}}</text>
      <text class="filter-pill__arrow">▾</text>
    </view>
  </picker>

  <!--
    ── 分段切换 ──────────────────────────────────────────────────
    取自参考图 IKEA 顶部「Rooms │ Products」页签：下划线指示当前项。
    每段带计数 —— 一次只显示一段，靠计数保住"看板全貌"。
    ★ 三段计数之和会大于顶部「共 N 项」：周期任务同时算在它所属的
      阶段段里，分段不是一组互斥的阶段。见 index.js 文件头。
  -->
  <view class="seg board__seg">
    <view
      wx:for="{{tabs}}"
      wx:key="seg"
      class="seg__item {{segmentTab === item.seg ? 'seg__item--on' : ''}} hit"
      data-segment="{{item.seg}}"
      bindtap="onSegmentTap"
    >
      <text>{{item.seg}}</text>
      <text class="seg__count">{{item.count}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-block">正在加载看板…</view>

  <block wx:else>
    <view wx:if="{{segmentTab === '周期性' && flat.length}}">
      <!--
        周期性段：平铺，顺序即周期顺序（index.js 里已排好）。
        ★ 传 recur-mode：这一段是「按周期看」，右上角该是周期（每月）而不是来源。
          下面分组列表那一处不传 —— 它是「按阶段看」，来源仍是有用的信息。
      -->
      <task-card
        wx:for="{{flat}}"
        wx:for-item="task"
        wx:key="_id"
        task="{{task}}"
        recur-mode="{{true}}"
        bind:tap="onTaskTap"
      />
    </view>

    <block wx:elif="{{groups.length}}">
      <!-- 当前分段内按任务分类分组，每组可点标题折叠 -->
      <view
        wx:for="{{groups}}"
        wx:for-item="group"
        wx:key="key"
        class="board__group"
      >
        <!-- 外层负责吸顶：吸附范围就是本组，滚过本组会被下一组顶走 -->
        <view class="board__group-sticky">
          <view
            class="board__group-head hit"
            data-category="{{group.category}}"
            bindtap="onToggleGroup"
          >
            <view class="chip__dot" style="background: {{group.color}}"></view>
            <text class="board__group-title ellipsis">{{group.category}}</text>
            <text class="board__group-count">{{group.tasks.length}}</text>
            <text class="board__group-arrow">{{group.collapsed ? '▸' : '▾'}}</text>
          </view>
        </view>

        <block wx:if="{{!group.collapsed}}">
          <task-card
            wx:for="{{group.tasks}}"
            wx:for-item="task"
            wx:key="_id"
            task="{{task}}"
            bind:tap="onTaskTap"
          />
        </block>
      </view>
    </block>

    <empty-state
      wx:else
      title="这一段下没有任务"
      hint="上方可以切换分段，或换一个分类看看"
    />
  </block>
</view>
