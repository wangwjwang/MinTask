/* pages/claim 认领页 */

.claim__intro {
  margin-bottom: var(--gap);
}

.claim__error {
  border-left: 8rpx solid var(--tone-warn);
}

.claim__error-title {
  margin-bottom: 8rpx;
}

.claim__retry {
  display: inline-flex;
  margin-top: 24rpx;
}

/*
 * 成员卡的布局（avatar / name / dept）在 app.wxss 的 .member 系列里，
 * 与人员看板共用。这里只加"可选中"这一层语义 ——
 * 选中态是一圈主色描边，不是背景填色：
 * 填色会和卡壳红条、状态徽标的浅底色混淆，描边则明确是"你选中了它"。
 */
.claim__item {
  border: 4rpx solid transparent;
  transition: border-color 0.15s ease, background 0.15s ease;
}

.claim__item--active {
  border-color: var(--primary);
  background: var(--primary-soft);
}

