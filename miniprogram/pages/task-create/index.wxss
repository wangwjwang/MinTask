/* pages/task-create */

/*
 * .field--picker / .picker__label 已上提到 app.wxss ——
 * 本页原先抄了一份和 field-picker 组件完全相同的定义，现已删除。
 */

.create__self-tag {
  margin-left: 12rpx;
}

/* ── 协办人多选面板 ── */

.create__members {
  margin-top: 8rpx;
  border-top: 2rpx solid var(--divider);
  padding-top: 8rpx;
}

.create__members-empty {
  padding: 24rpx 0;
  text-align: center;
}

/*
 * ★ 成员行（.pick-row 系列）与勾选标记（.pick__check）已上提到 app.wxss。
 *   原先报任务和改任务各写了一份逐字相同的 .create__member* / .edit__member*，
 *   同 .field--picker 一样属于跨页重复定义，只能放全局。
 */

.create__tip {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-sm);
  background: var(--bg);
  line-height: 1.6;
}
