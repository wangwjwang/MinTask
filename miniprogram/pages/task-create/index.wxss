/* pages/task-create */

/*
 * picker 包裹的 .field--picker 需要撑满宽度；
 * .picker__label 由 field-picker 组件定义，这里补一份供本页内联使用。
 */
.field--picker {
  width: 100%;
}

.picker__label {
  flex: 1;
  margin-bottom: 0;
  margin-right: 24rpx;
}

.create__self-tag {
  margin-left: 12rpx;
}

/* ── 协办人多选面板 ── */

.create__members {
  margin-top: 8rpx;
  border-top: 2rpx solid var(--divider);
  padding-top: 8rpx;
}

.create__members-empty {
  padding: 24rpx 0;
  text-align: center;
}

.create__member {
  display: flex;
  align-items: center;
  padding: 22rpx 4rpx;
  border-bottom: 2rpx solid var(--divider);
}

.create__member:last-child {
  border-bottom: none;
}

.create__member--on {
  color: var(--primary);
}

.create__member-name {
  font-size: 28rpx;
}

.create__member-dept {
  margin-left: 12rpx;
}

.create__member-check {
  color: var(--primary);
  font-size: 32rpx;
  font-weight: 600;
}

.create__tip {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-sm);
  background: var(--bg);
  line-height: 1.6;
}
